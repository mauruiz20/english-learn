# Copy to .env (gitignored) for local development: cp .env.example .env

# docker compose up -d starts this database.
DATABASE_URL=postgresql+asyncpg://english_learn:english_learn@127.0.0.1:5433/english_learn

# Public OAuth client ids accepted as the ID token's audience (not secrets: they ship in the
# apps). Comma-separated; defaults to the web client below. Add the iOS/Android ids when they exist.
# GOOGLE_CLIENT_IDS=78200832989-odkefhj0s4vla7h5p83gevs2440mctev.apps.googleusercontent.com

# Secret, at least 32 bytes and 16 distinct bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Key rotation instead of JWT_SECRET (set one or the other): every listed key verifies,
# JWT_ACTIVE_KID signs. JWT_SECRET alone signs with kid "default".
# JWT_KEYS={"default": "<old secret>", "2026-11": "<new secret>"}
# JWT_ACTIVE_KID=2026-11

# development | test | production. Production requires CORS_ORIGINS (https, no localhost) and
# hides /docs, /redoc and /openapi.json.
# ENV=development

# Optional (defaults shown). Durations take seconds or ISO 8601 (P14D, PT5M).
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=P14D
# SESSION_MAX_LIFETIME=P60D
# REFRESH_RETRY_GRACE=45
# REAUTHENTICATION_WINDOW=300
# CORS_ORIGINS=https://english.maumar.com.ar,http://localhost:8081
# REFRESH_COOKIE_SECURE=true
# MAX_REQUEST_BODY_BYTES=1048576
# LOG_LEVEL=INFO
