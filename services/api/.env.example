# Copy to .env (gitignored) for local development: cp .env.example .env

# docker compose up -d starts this database.
DATABASE_URL=postgresql+asyncpg://english_learn:english_learn@127.0.0.1:5433/english_learn

# Public OAuth client ids accepted as the ID token's audience (not secrets: they ship in the
# apps). Comma-separated; defaults to the web client below. Add the iOS/Android ids when they exist.
# GOOGLE_CLIENT_IDS=78200832989-odkefhj0s4vla7h5p83gevs2440mctev.apps.googleusercontent.com

# Secret, at least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional (defaults shown). TTLs take seconds or ISO 8601 durations.
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=P30D
# CORS_ORIGINS=https://english-learn-iwl.pages.dev,http://localhost:8081
# MAX_REQUEST_BODY_BYTES=1048576
# LOG_LEVEL=INFO
