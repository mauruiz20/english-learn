{
  "name": "@english-learn/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@english-learn/content": "workspace:*",
    "@english-learn/domain": "workspace:*",
    "@english-learn/storage-sqlite": "workspace:*",
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest && node --test scripts/*.test.mjs",
    "export:web": "expo export -p web && node scripts/build-service-worker.mjs && node scripts/check-prod-bundle.mjs",
    "export:web:e2e": "EXPO_PUBLIC_E2E=1 expo export -p web --output-dir dist-e2e && node scripts/build-service-worker.mjs --dir dist-e2e",
    "serve:web": "node scripts/serve-web.mjs",
    "e2e:web": "pnpm export:web:e2e && playwright test",
    "generate:sounds": "node scripts/generate-sounds.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "./jest.global-setup.js",
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/",
      "/dist-e2e/",
      "/scripts/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
}
