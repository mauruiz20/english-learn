{
  "components": {
    "schemas": {
      "ClaimTransferRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token"],
        "title": "ClaimTransferRequest",
        "type": "object"
      },
      "ClaimTransferResponse": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/TransferredEvent"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": ["events"],
        "title": "ClaimTransferResponse",
        "type": "object"
      },
      "CookieSignInResponse": {
        "description": "Cookie transport: the refresh token is only in the HttpOnly `el_rt` cookie.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": ["accessToken", "accessTokenExpiresAt", "user"],
        "title": "CookieSignInResponse",
        "type": "object"
      },
      "CookieTokensResponse": {
        "description": "Cookie transport: the refresh token is only in the HttpOnly `el_rt` cookie.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "title": "Accesstokenexpiresat",
            "type": "string"
          }
        },
        "required": ["accessToken", "accessTokenExpiresAt"],
        "title": "CookieTokensResponse",
        "type": "object"
      },
      "CreateTransferRequest": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "description": "Every event of the device's log, as `POST /v1/sync` uploads them",
            "items": {
              "$ref": "#/components/schemas/EventRequest"
            },
            "maxItems": 20000,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          }
        },
        "required": ["events"],
        "title": "CreateTransferRequest",
        "type": "object"
      },
      "CreateTransferResponse": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "token": {
            "description": "Secret, single use: pass it to the new site in the URL fragment",
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token", "expiresAt"],
        "title": "CreateTransferResponse",
        "type": "object"
      },
      "EventRequest": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "UUIDv7, lowercase, unique per user",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Id",
            "type": "string"
          },
          "localDate": {
            "description": "YYYY-MM-DD",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "title": "Localdate",
            "type": "string"
          },
          "occurredAt": {
            "description": "Epoch ms",
            "exclusiveMaximum": 4102444800000.0,
            "minimum": 946684800000.0,
            "title": "Occurredat",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "description": "Opaque JSON object, at most 8 KiB",
            "title": "Payload",
            "type": "object"
          },
          "type": {
            "description": "Unknown types are stored as well",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["id", "occurredAt", "localDate", "type", "payload"],
        "title": "EventRequest",
        "type": "object"
      },
      "EventResponse": {
        "properties": {
          "deviceId": {
            "description": "The device that uploaded it first",
            "format": "uuid",
            "title": "Deviceid",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "localDate": {
            "format": "date",
            "title": "Localdate",
            "type": "string"
          },
          "occurredAt": {
            "title": "Occurredat",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["id", "deviceId", "occurredAt", "localDate", "type", "payload"],
        "title": "EventResponse",
        "type": "object"
      },
      "GoogleSignInRequest": {
        "additionalProperties": false,
        "properties": {
          "idToken": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Idtoken",
            "type": "string"
          },
          "nonce": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The nonce the client put in the Google authorization request; the ID token's `nonce` claim must equal it. Required with `X-Token-Transport: cookie` (web).",
            "title": "Nonce"
          }
        },
        "required": ["idToken"],
        "title": "GoogleSignInRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RefreshTokenRequest": {
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Refreshtoken",
            "type": "string"
          }
        },
        "required": ["refreshToken"],
        "title": "RefreshTokenRequest",
        "type": "object"
      },
      "SignInResponse": {
        "description": "Body transport (default): the refresh token is in the JSON.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "refreshToken": {
            "title": "Refreshtoken",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": ["accessToken", "accessTokenExpiresAt", "refreshToken", "user"],
        "title": "SignInResponse",
        "type": "object"
      },
      "SyncRequest": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "`cursor` from the previous response; null on a first sync",
            "title": "Cursor"
          },
          "deviceId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Deviceid",
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventRequest"
            },
            "maxItems": 500,
            "title": "Events",
            "type": "array"
          }
        },
        "required": ["deviceId", "cursor", "events"],
        "title": "SyncRequest",
        "type": "object"
      },
      "SyncResponse": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "conflicts": {
            "description": "Ids already stored with other content; first one kept",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Conflicts",
            "type": "array"
          },
          "cursor": {
            "description": "Send back as `cursor` next time",
            "title": "Cursor",
            "type": "integer"
          },
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventResponse"
            },
            "title": "Events",
            "type": "array"
          },
          "hasMore": {
            "description": "More events after `cursor`: sync again",
            "title": "Hasmore",
            "type": "boolean"
          }
        },
        "required": ["events", "cursor", "hasMore", "accepted", "duplicates", "conflicts"],
        "title": "SyncResponse",
        "type": "object"
      },
      "TokenTransport": {
        "enum": ["body", "cookie"],
        "title": "TokenTransport",
        "type": "string"
      },
      "TokensResponse": {
        "description": "Body transport (default): the refresh token is in the JSON.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "format": "date-time",
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "refreshToken": {
            "title": "Refreshtoken",
            "type": "string"
          }
        },
        "required": ["accessToken", "accessTokenExpiresAt", "refreshToken"],
        "title": "TokensResponse",
        "type": "object"
      },
      "TransferredEvent": {
        "description": "An event as it was uploaded (no device: the claiming device adopts it).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "localDate": {
            "title": "Localdate",
            "type": "string"
          },
          "occurredAt": {
            "title": "Occurredat",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["id", "occurredAt", "localDate", "type", "payload"],
        "title": "TransferredEvent",
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": ["id", "email"],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token from /v1/auth/*",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "English Learn API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": ["health"]
      }
    },
    "/v1/account": {
      "delete": {
        "description": "Permanently delete the account and all synced progress.\n\nNeeds an access token from a Google sign-in less than 5 minutes old (401\n`reauthentication_required` otherwise): the client signs in again first.",
        "operationId": "delete_my_account_v1_account_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete My Account",
        "tags": ["account"]
      }
    },
    "/v1/auth/google": {
      "post": {
        "description": "Exchange a Google ID token for API tokens.\n\n`nonce` is checked against the token's `nonce` claim when sent; cookie mode (the web\napp's OpenID Connect redirect flow) requires it.",
        "operationId": "sign_in_with_google_v1_auth_google_post",
        "parameters": [
          {
            "description": "`cookie` (web): the refresh token travels in the HttpOnly `el_rt` cookie and is left out of the JSON. `body` (default): it travels in the JSON body.",
            "in": "header",
            "name": "X-Token-Transport",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TokenTransport",
              "default": "body",
              "description": "`cookie` (web): the refresh token travels in the HttpOnly `el_rt` cookie and is left out of the JSON. `body` (default): it travels in the JSON body."
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SignInResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CookieSignInResponse"
                    }
                  ],
                  "title": "Response Sign In With Google V1 Auth Google Post"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie mode: `Set-Cookie: el_rt=<refresh token>; HttpOnly; Secure; SameSite=Strict; Path=/v1/auth; Max-Age=<seconds until the token expires>`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign In With Google",
        "tags": ["auth"]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Revoke the refresh token and every token rotated from the same sign-in.\n\nCookie mode reads the `el_rt` cookie (same CSRF rules as refresh) and always clears it.",
        "operationId": "log_out_v1_auth_logout_post",
        "parameters": [
          {
            "description": "`cookie` (web): the refresh token travels in the HttpOnly `el_rt` cookie and is left out of the JSON. `body` (default): it travels in the JSON body.",
            "in": "header",
            "name": "X-Token-Transport",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TokenTransport",
              "default": "body",
              "description": "`cookie` (web): the refresh token travels in the HttpOnly `el_rt` cookie and is left out of the JSON. `body` (default): it travels in the JSON body."
            }
          },
          {
            "description": "Cookie mode only: must be `english-learn` (CSRF defense).",
            "in": "header",
            "name": "X-Requested-With",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cookie mode only: must be `english-learn` (CSRF defense).",
              "title": "X-Requested-With"
            }
          },
          {
            "description": "Cookie mode: the refresh token (HttpOnly, set by sign-in and refresh).",
            "in": "cookie",
            "name": "el_rt",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cookie mode: the refresh token (HttpOnly, set by sign-in and refresh).",
              "title": "El Rt"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshTokenRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie mode: clears `el_rt` (`Max-Age=0`)",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Log Out",
        "tags": ["auth"]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "description": "Rotate the refresh token. Each refresh token works once.\n\nBody mode reads `refreshToken` from the body. Cookie mode reads the `el_rt` cookie (the\nbody is ignored), needs `X-Requested-With: english-learn` and an allowed `Origin`, and\nclears the cookie when the session cannot continue (401).",
        "operationId": "refresh_session_v1_auth_refresh_post",
        "parameters": [
          {
            "description": "`cookie` (web): the refresh token travels in the HttpOnly `el_rt` cookie and is left out of the JSON. `body` (default): it travels in the JSON body.",
            "in": "header",
            "name": "X-Token-Transport",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TokenTransport",
              "default": "body",
              "description": "`cookie` (web): the refresh token travels in the HttpOnly `el_rt` cookie and is left out of the JSON. `body` (default): it travels in the JSON body."
            }
          },
          {
            "description": "Cookie mode only: must be `english-learn` (CSRF defense).",
            "in": "header",
            "name": "X-Requested-With",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cookie mode only: must be `english-learn` (CSRF defense).",
              "title": "X-Requested-With"
            }
          },
          {
            "description": "Cookie mode: the refresh token (HttpOnly, set by sign-in and refresh).",
            "in": "cookie",
            "name": "el_rt",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cookie mode: the refresh token (HttpOnly, set by sign-in and refresh).",
              "title": "El Rt"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshTokenRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/TokensResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CookieTokensResponse"
                    }
                  ],
                  "title": "Response Refresh Session V1 Auth Refresh Post"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie mode: `Set-Cookie: el_rt=<refresh token>; HttpOnly; Secure; SameSite=Strict; Path=/v1/auth; Max-Age=<seconds until the token expires>`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh Session",
        "tags": ["auth"]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": ["account"]
      }
    },
    "/v1/sync": {
      "post": {
        "description": "Upload this device's events and download the account's events after `cursor`.\n\nUploads are idempotent by event id. Keep syncing with the returned `cursor` while\n`hasMore` is true. The returned events include the ones just uploaded.",
        "operationId": "sync_progress_v1_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "`device_conflict`: use a new device id"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Sync Progress",
        "tags": ["sync"]
      }
    },
    "/v1/transfers": {
      "post": {
        "description": "Store a device's events for 15 minutes and return a single-use token.\n\nAnonymous and without credentials: the old web site calls it before sending the learner\nto the new one with the token in the URL fragment.",
        "operationId": "create_transfer_v1_transfers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTransferResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "Body over 2 MiB"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "`transfer_capacity`: too many transfers right now; `busy`: too many in progress at once"
          }
        },
        "summary": "Create Transfer",
        "tags": ["transfers"]
      }
    },
    "/v1/transfers/claim": {
      "post": {
        "description": "Return a transfer's events, exactly once; the transfer is deleted.",
        "operationId": "claim_transfer_v1_transfers_claim_post",
        "requestBody": {
          "content": {
