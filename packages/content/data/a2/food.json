  "passages": [
    {
      "id": "a2.food.dinner-together",
      "level": "A2",
      "topics": ["food"],
      "title": "Dinner together",
      "text": "On Fridays, my family cooks dinner together. My father makes rice and chicken, and my sister and I prepare a salad with fresh vegetables. We don't eat much bread at dinner, but we always have some fruit after the meal. Last Friday my mother made a delicious soup, so we didn't need any chicken. Next week I'm going to cook for everyone!",
      "source": {
        "kind": "original"
      }
    }
  ],
