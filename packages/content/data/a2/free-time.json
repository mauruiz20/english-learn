    {
      "id": "a2.free-time.my-weekends",
      "level": "A2",
      "topics": ["free-time"],
      "title": "My weekends",
      "text": "I work hard during the week, so I love my free time. On Saturday mornings I go swimming with my sister. In the afternoon I usually read or play the guitar. I can't sing very well, but I really like playing music. On Saturday nights my friends and I go out. Last weekend we watched a movie and then went dancing.",
      "source": {
        "kind": "original"
      }
    }
