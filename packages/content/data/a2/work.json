  "passages": [
    {
      "id": "a2.work.new-job",
      "level": "A2",
      "topics": ["work"],
      "title": "A new job",
      "text": "Carlos started a new job in March. He works in an office in the city center. He has to start at nine, but he often arrives at eight thirty. His boss is friendly and his colleagues help him a lot. On Fridays he works from home. Next year he is going to look for a bigger apartment near the office.",
      "source": {
        "kind": "original"
      }
    }
  ],
