  "cards": [
    {
      "id": "a2.phrasal-verbs.daily-routine",
      "level": "A2",
      "topic": "phrasal-verbs",
      "kind": "phrasal_verbs",
      "title": "Phrasal verbs: la rutina diaria",
      "summary": "Cinco phrasal verbs para contar tu día, desde que te despiertas hasta que apagas la luz.",
      "form": "verbo + partícula (up, on, off): la partícula cambia el significado",
      "uses": [
        "Contar tu rutina: I wake up at seven and get up at seven fifteen.",
        "Ropa: put on (ponerse) y take off (quitarse).",
        "Aparatos y luces: turn off (apagar); lo contrario es turn on.",
        "Con un pronombre, el pronombre va en el medio: put it on, turn it off."
      ],
      "pitfalls": [
        {
          "wrong": "I put on it.",
          "right": "I put it on.",
          "why": "Con pronombres (it, them), el pronombre va entre el verbo y la partícula."
        },
        {
          "wrong": "Can you open the light?",
          "right": "Can you turn on the light?",
          "why": "Encender la luz no es open: se dice turn on (y apagarla, turn off)."
        },
        {
          "wrong": "Take out your shoes, please.",
          "right": "Take off your shoes, please.",
          "why": "Quitarse la ropa o los zapatos es take off; take out es sacar."
        }
      ],
      "examples": [
        {
          "en": "I usually wake up at six thirty.",
          "es": "Normalmente me despierto a las seis y media."
        },
        {
          "en": "I don't get up until seven.",
          "es": "No me levanto hasta las siete."
        },
        {
          "en": "She put her coat on and left.",
          "es": "Se puso el abrigo y se fue."
        },
        {
          "en": "He took his shoes off at the door.",
          "es": "Se quitó los zapatos en la puerta."
        },
        {
          "en": "Can you turn the TV off?",
          "es": "¿Puedes apagar la tele?"
        },
        {
          "en": "Don't forget to turn off your phone.",
          "es": "No te olvides de apagar tu celular."
        }
      ],
      "entries": [
        {
          "verb": "wake up",
          "es": "despertarse; despertar (a alguien)",
          "separable": true,
          "example": {
            "en": "Please wake me up at seven.",
            "es": "Por favor, despiértame a las siete."
          }
        },
        {
          "verb": "get up",
          "es": "levantarse (de la cama)",
          "separable": false,
          "example": {
            "en": "I get up at seven fifteen.",
            "es": "Me levanto a las siete y cuarto."
          }
        },
        {
          "verb": "put on",
          "es": "ponerse (ropa)",
          "separable": true,
          "example": {
            "en": "Put on your jacket. It's cold.",
            "es": "Ponte la chaqueta. Hace frío."
          }
        },
        {
          "verb": "take off",
          "es": "quitarse (ropa)",
          "separable": true,
          "example": {
            "en": "Please take off your shoes.",
            "es": "Por favor, quítate los zapatos."
          }
        },
        {
          "verb": "turn off",
          "es": "apagar",
          "separable": true,
          "example": {
            "en": "Turn off the lights before you go to bed.",
            "es": "Apaga las luces antes de acostarte."
          }
        }
      ],
