  "lessons": [
    {
      "id": "a2.directions.lesson-001",
      "level": "A2",
      "topic": "directions",
      "title": "¿Cómo llego?",
      "exerciseIds": [
        "a2.directions.vocab-001",
        "a2.directions.cloze-001",
        "a2.directions.order-001",
        "a2.directions.choice-001",
