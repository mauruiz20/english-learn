    {
      "id": "a2.directions.to-the-museum",
      "level": "A2",
      "topics": ["directions"],
      "title": "How to get to the museum",
      "text": "A tourist asks a woman, \"Excuse me, how do I get to the museum?\" She answers, \"It's not far from here. Go straight ahead for two blocks and turn left at the bank. Then walk past the park. The museum is on the corner, across from the train station. It takes about ten minutes on foot.\"",
      "source": { "kind": "original" }
    }
  ],
