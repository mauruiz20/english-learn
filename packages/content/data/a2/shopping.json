    {
      "id": "a2.shopping.new-jacket",
      "level": "A2",
      "topics": ["shopping"],
      "title": "A new jacket",
      "text": "Last Saturday I went to the market with my friend Sam. I wanted to buy a new jacket for the winter. The first jacket I tried on was very nice, but it was too expensive. In the next store, I found a cheaper one in my size. It cost forty dollars. I paid in cash, and then we went for coffee.",
      "source": {
        "kind": "original"
      }
    }
  ],
