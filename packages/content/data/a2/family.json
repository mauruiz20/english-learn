  "passages": [
    {
      "id": "a2.family.my-family",
      "level": "A2",
      "topics": ["family"],
      "title": "My family",
      "text": "I live with my parents and my grandmother in a small house. My mother is a nurse and my father works in a bank. I don't have any brothers or sisters, so I'm an only child, but I have six cousins! My cousin Lucía is my best friend. She is two years older than me and she looks like her mother. Last year my uncle got married, and the whole family had a big party.",
      "source": {
        "kind": "original"
      }
    }
  ],
