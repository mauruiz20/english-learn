  "passages": [
    {
      "id": "a2.situations.practice-hotel-arrival",
      "level": "A2",
      "topics": ["situations"],
      "title": "Checking in",
      "text": "Receptionist: Good evening. Welcome to the Lincoln Hotel. Mr. Díaz: Hi, I have a reservation under Díaz. Receptionist: Let me see. Yes, a double room for two nights. Can I see your ID, please? Mr. Díaz: Sure, here you go. Is breakfast included? Receptionist: Yes, it is. Breakfast is from seven to ten on the first floor. Here are your key cards. You're in room 305. Mr. Díaz: Great. And where is the elevator? Receptionist: Just behind you, on the left.",
      "source": {
        "kind": "original"
      }
    }
  ],
