  "passages": [
    {
      "id": "a2.situations.practice-doctor-visit",
      "level": "A2",
      "topics": ["situations"],
      "title": "At the doctor's office",
      "text": "Doctor: Hello, Ms. García. What seems to be the problem? Ana: I have a sore throat, and my head hurts. It started three days ago. Doctor: Do you have a fever? Ana: A little, last night. Doctor: Let me take a look. It's an infection. Here's a prescription for some antibiotics. Take one pill twice a day for a week. Ana: Can I go to work tomorrow? Doctor: No, rest at home for two days. If you don't feel better by Friday, make another appointment.",
      "source": { "kind": "original" }
    }
  ],
