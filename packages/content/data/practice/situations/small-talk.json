{
  "items": [
    {
      "id": "b1.situations.hows-it-going",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "How's it going?",
      "es": "¿Qué tal?, ¿cómo va todo? (informal)",
      "example": {
        "en": "Hey, Tom! How's it going?",
        "es": "¡Hola, Tom! ¿Qué tal?"
      }
    },
    {
      "id": "b1.situations.what-do-you-do",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "What do you do?",
      "es": "¿A qué te dedicas?",
      "example": {
        "en": "So, what do you do? I'm a nurse.",
        "es": "Y, ¿a qué te dedicas? Soy enfermera."
      }
    },
    {
      "id": "b1.situations.what-brings-you-here",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "What brings you here?",
      "es": "¿Qué te trae por aquí?",
      "example": {
        "en": "So, what brings you here? Are you a friend of the bride?",
        "es": "¿Y qué te trae por aquí? ¿Eres amigo de la novia?"
      }
    },
    {
      "id": "b1.situations.how-do-you-know",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "How do you know (someone)?",
      "es": "¿De dónde conoces a (alguien)?",
      "example": {
        "en": "How do you know Sara? We work together.",
        "es": "¿De dónde conoces a Sara? Trabajamos juntos."
      }
    },
    {
      "id": "b1.situations.nice-talking-to-you",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "It was nice talking to you.",
      "es": "Fue un gusto hablar contigo.",
      "example": {
        "en": "I have to go now. It was nice talking to you!",
        "es": "Ya me tengo que ir. ¡Fue un gusto hablar contigo!"
      }
    },
    {
      "id": "b1.situations.beautiful-day-isnt-it",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "Beautiful day, isn't it?",
      "es": "Hace un día precioso, ¿no?",
      "example": {
        "en": "Beautiful day, isn't it? Yes, finally some sun!",
        "es": "Hace un día precioso, ¿no? Sí, ¡por fin un poco de sol!"
      }
    }
  ],
  "passages": [
    {
      "id": "b1.situations.practice-small-talk-wedding",
      "level": "B1",
      "topics": ["situations"],
      "title": "At the wedding",
      "text": "Emma: Hi! I don't think we've met. I'm Emma. Daniel: Hi, Emma. I'm Daniel. Beautiful day, isn't it? Emma: It really is. So, how do you know the bride? Daniel: We went to college together. What about you? Emma: She's my cousin. And what do you do, Daniel? Daniel: I'm a nurse. I work at a children's hospital. Emma: That sounds interesting! Well, I should go and find my seat. It was nice talking to you. Daniel: You too!",
      "source": { "kind": "original" }
    }
  ],
