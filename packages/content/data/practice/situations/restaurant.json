    {
      "id": "a2.situations.practice-restaurant-dinner",
      "level": "A2",
      "topics": ["situations"],
      "title": "Dinner for two",
      "text": "Server: Good evening! A table for two? Sam: Yes, please. Server: Here are your menus. Are you ready to order? Sam: Almost. What do you recommend? Server: The fish tacos are very popular. Sam: OK, I'll have the fish tacos. Mia: And I'd like the vegetable soup, please. Server: Great. Anything to drink? Mia: Just some water, please. Sam (later): Excuse me, could we have the check, please? Server: Sure, here you go.",
      "source": { "kind": "original" }
    }
  ],
