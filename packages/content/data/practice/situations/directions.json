  "passages": [
    {
      "id": "a2.situations.practice-directions-museum",
      "level": "A2",
      "topics": ["situations"],
      "title": "The way to the museum",
      "text": "Daniel: Excuse me, how do I get to the art museum? Woman: The art museum? Go straight down this street and take the second street on the left. Daniel: Is it far from here? Woman: No, it's about a ten-minute walk. You'll walk past a big park and a church. The museum is right after the church, on your right. Daniel: Great, thank you! Woman: You're welcome. Enjoy your visit!",
      "source": { "kind": "original" }
    }
  ],
