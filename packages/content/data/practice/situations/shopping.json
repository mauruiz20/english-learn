  "passages": [
    {
      "id": "b1.situations.practice-shopping-jacket",
      "level": "B1",
      "topics": ["situations"],
      "title": "The jacket that didn't fit",
      "text": "Clerk: Hi, can I help you? Marta: Yes, I bought this jacket last week, but it's too small. Can I exchange it for a bigger size? Clerk: Sure. Do you have the receipt? Marta: Here it is. Clerk: Let me check. I'm sorry, we don't have it in a large. Would you like to return it? Marta: Yes. Can I get a refund? Clerk: After seven days, we can only give you store credit. Marta: OK, store credit is fine. I'll look for something else.",
      "source": { "kind": "original" }
    }
  ],
