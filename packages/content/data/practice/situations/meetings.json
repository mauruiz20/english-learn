  "passages": [
    {
      "id": "b2.situations.practice-meetings-email",
      "level": "B2",
      "topics": ["situations"],
      "title": "Project update",
      "text": "Hi Mark, Thank you for your time at yesterday's meeting. Please find attached the new budget for the website project. As we discussed, we need to move on to the design stage next week, so I'd appreciate your comments by Thursday. If you have any questions, just let me know. I look forward to hearing from you. Best regards, Laura Kim",
      "source": { "kind": "original" }
    }
  ],
