{
  "items": [
    {
      "id": "b1.situations.could-i-speak-to",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "Could I speak to (someone)?",
      "es": "¿Podría hablar con (alguien)?",
      "example": {
        "en": "Hello, could I speak to Dr. Silva, please?",
        "es": "Hola, ¿podría hablar con la doctora Silva, por favor?"
      }
    },
    {
      "id": "b1.situations.whos-calling",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "Who's calling?",
      "es": "¿De parte de quién?",
      "example": {
        "en": "May I ask who's calling?",
        "es": "¿De parte de quién?"
      }
    },
    {
      "id": "b1.situations.im-calling-about",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "I'm calling about (something).",
      "es": "Llamo por (algo).",
      "example": {
        "en": "Hi, I'm calling about the job ad on your website.",
        "es": "Hola, llamo por el anuncio de trabajo de su sitio web."
      }
    },
    {
      "id": "b1.situations.leave-a-message",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "leave a message",
      "es": "dejar un mensaje",
      "example": {
        "en": "She's in a meeting. Would you like to leave a message?",
        "es": "Está en una reunión. ¿Quieres dejarle un mensaje?"
      }
    },
    {
      "id": "b1.situations.youre-breaking-up",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "You're breaking up.",
      "es": "Se corta la llamada, te escucho entrecortado.",
      "example": {
        "en": "Sorry, I can't hear you. You're breaking up.",
        "es": "Perdón, no te escucho. Se corta la llamada."
      }
    },
    {
      "id": "b1.situations.this-is-on-the-phone",
      "level": "B1",
      "topics": ["situations"],
      "kind": "phrase",
      "term": "This is (name).",
      "es": "habla (nombre), soy (nombre) (al teléfono)",
      "example": {
        "en": "Hi, Carla, this is Ben. I'm calling from the bank.",
        "es": "Hola, Carla, habla Ben. Te llamo del banco."
      }
    }
  ],
  "passages": [
    {
      "id": "b1.situations.practice-phone-doctors-office",
      "level": "B1",
      "topics": ["situations"],
      "title": "Calling the doctor's office",
      "text": "Receptionist: Good morning, Dr. Silva's office. How can I help you? Paul: Hi, could I speak to Dr. Silva, please? Receptionist: I'm sorry, she's with a patient right now. Who's calling, please? Paul: This is Paul Ross. I'm calling about my appointment on Friday. Receptionist: Would you like to leave a message? Paul: Yes, please. Could you ask her to call me back this afternoon? Receptionist: Of course. Sorry, Mr. Ross, you're breaking up. Did you say this afternoon? Paul: Yes, after three. Thank you!",
      "source": { "kind": "original" }
    }
  ],
