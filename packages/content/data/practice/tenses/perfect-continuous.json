{
  "items": [
    {
      "id": "b1.tenses.present-perfect-continuous",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present perfect continuous (I've been working)",
      "es": "presente perfecto continuo: have / has been + verbo-ing",
      "example": {
        "en": "She's tired because she has been running all morning.",
        "es": "Está cansada porque ha estado corriendo toda la mañana."
      }
    },
    {
      "id": "b1.tenses.how-long-been-doing",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "How long have you been + -ing? (How long have you been waiting?)",
      "es": "¿cuánto tiempo llevas…? / ¿cuánto tiempo hace que…?",
      "example": {
        "en": "How long have you been learning English?",
        "es": "¿Cuánto tiempo llevas aprendiendo inglés?"
      }
    },
    {
      "id": "b1.tenses.been-living-since",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "I've been living here since… (not I'm living here since…)",
      "es": "vivo aquí desde… / llevo… viviendo aquí (nunca con el presente)",
      "example": {
        "en": "I've been living here since 2019.",
        "es": "Vivo aquí desde 2019."
      }
    },
    {
      "id": "b1.tenses.visible-result",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present perfect continuous for a visible result (You've been crying)",
      "es": "algo que estuviste haciendo y todavía se nota",
      "example": {
        "en": "Your eyes are red. Have you been crying?",
        "es": "Tienes los ojos rojos. ¿Has estado llorando?"
      }
    },
    {
      "id": "b1.tenses.lately",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "word",
      "term": "lately",
      "es": "últimamente",
      "example": {
        "en": "I've been sleeping badly lately.",
        "es": "Últimamente he estado durmiendo mal."
      }
    },
    {
      "id": "b1.tenses.all-day",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "phrase",
      "term": "all day (I've been working all day)",
      "es": "todo el día",
      "example": {
        "en": "It's been raining all day.",
        "es": "Ha estado lloviendo todo el día."
      }
    }
  ],
  "passages": [
    {
      "id": "b1.tenses.practice-perfect-continuous-maya",
      "level": "B1",
      "topics": ["tenses"],
      "title": "A busy month",
      "text": "Maya looks tired, and there's a good reason. She has been preparing for a marathon for three months, and lately she has been running almost every day. This week she has also been studying for an important exam, so she hasn't been sleeping well. \"I've been drinking too much coffee,\" she says with a smile. Her race is next Sunday, and she can't wait.",
      "source": { "kind": "original" }
    }
  ],
