{
  "items": [
    {
      "id": "b1.tenses.present-perfect-experience",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present perfect for experiences (I've tried sushi)",
      "es": "presente perfecto: experiencias (alguna vez, nunca)",
      "example": {
        "en": "I've never seen the ocean.",
        "es": "Nunca he visto el mar."
      }
    },
    {
      "id": "b1.tenses.present-perfect-unfinished-time",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present perfect with unfinished time (today, this week)",
      "es": "presente perfecto con un período que no terminó (hoy, esta semana)",
      "example": {
        "en": "I've drunk three cups of coffee today.",
        "es": "Hoy me he tomado tres cafés."
      }
    },
    {
      "id": "b1.tenses.just-done",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "just + present perfect (I've just eaten)",
      "es": "acabar de (have just + participio)",
      "example": {
        "en": "The train has just left.",
        "es": "El tren acaba de salir."
      }
    },
    {
      "id": "b1.tenses.already-done",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "already + present perfect (I've already paid)",
      "es": "ya (en afirmaciones)",
      "example": {
        "en": "We've already seen this movie.",
        "es": "Ya vimos esta película."
      }
    },
    {
      "id": "b1.tenses.yet-done",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "yet in questions and negatives (Have you finished yet? / not yet)",
      "es": "ya (en preguntas) y todavía (en negativas)",
      "example": {
        "en": "I haven't called the bank yet.",
        "es": "Todavía no he llamado al banco."
      }
    },
    {
      "id": "b1.tenses.how-long-have-you",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "How long have you…? (How long have you known her?)",
      "es": "¿cuánto tiempo hace que…? (con for / since)",
      "example": {
        "en": "How long have you known Ana?",
        "es": "¿Cuánto tiempo hace que conoces a Ana?"
      }
    }
  ],
  "passages": [
    {
      "id": "b1.tenses.practice-present-perfect-dan",
      "level": "B1",
      "topics": ["tenses"],
      "title": "A new city",
      "text": "Dan moved to a new city last month for work. He has already learned the names of the streets near his apartment, and he has made two friends at the office. He has never lived alone before, so it's a big change for him. This week he has cooked dinner every night. He hasn't visited the famous old market yet, but he wants to go on Saturday. His mom has just called him to ask how everything is going.",
      "source": { "kind": "original" }
    }
  ],
