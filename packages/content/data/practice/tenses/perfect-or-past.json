{
  "items": [
    {
      "id": "b1.tenses.past-simple-finished-time",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "past simple with a finished time (yesterday, in 2019, last week)",
      "es": "pasado simple con un momento terminado",
      "example": {
        "en": "She went to Mexico in 2018.",
        "es": "Fue a México en 2018."
      }
    },
    {
      "id": "b1.tenses.present-perfect-no-time",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present perfect without a specific time (I've lost my keys)",
      "es": "presente perfecto sin un momento concreto (importa el resultado)",
      "example": {
        "en": "Look! Someone has stolen my bike!",
        "es": "¡Mira! ¡Alguien se robó mi bicicleta!"
      }
    },
    {
      "id": "b1.tenses.ago",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "word",
      "term": "ago",
      "es": "hace (tiempo): three years ago = hace tres años",
      "example": {
        "en": "We moved here five years ago.",
        "es": "Nos mudamos aquí hace cinco años."
      }
    },
    {
      "id": "b1.tenses.when-did",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "When did…? (When did you arrive?)",
      "es": "¿cuándo…? siempre con pasado simple",
      "example": {
        "en": "When did you buy that jacket?",
        "es": "¿Cuándo compraste esa chaqueta?"
      }
    },
    {
      "id": "b1.tenses.been-gone",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "has been / has gone (She's gone to the bank)",
      "es": "has been: fue y ya volvió · has gone: se fue y todavía no vuelve",
      "example": {
        "en": "Tom isn't here. He's gone to the bank.",
        "es": "Tom no está. Se fue al banco."
      }
    },
    {
      "id": "b1.tenses.news-then-details",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "news in present perfect, details in past simple (I've had an accident. It happened…)",
      "es": "la noticia en presente perfecto, los detalles en pasado simple",
      "example": {
        "en": "I've cut my finger. I did it while I was cooking.",
        "es": "Me corté el dedo. Me pasó mientras cocinaba."
      }
    }
  ],
  "passages": [
    {
      "id": "b1.tenses.practice-perfect-or-past-news",
      "level": "B1",
      "topics": ["tenses"],
      "title": "Big news",
      "text": "Hi Sara! Guess what? I've found a new job! I saw the ad two weeks ago, and I had the interview last Friday. They called me yesterday and offered me the job. I've never worked for a big company before, so I'm a little nervous. My new boss has already sent me some documents to read. I start on Monday! Love, Leo",
      "source": { "kind": "original" }
    }
  ],
