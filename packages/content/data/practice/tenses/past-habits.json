{
  "items": [
    {
      "id": "b2.tenses.would-past-habits",
      "level": "B2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "would for repeated past actions (We would play outside)",
      "es": "would: acciones que se repetían en el pasado (solíamos…)",
      "example": {
        "en": "On Sundays, my grandfather would tell us stories.",
        "es": "Los domingos, mi abuelo nos contaba historias."
      }
    },
    {
      "id": "b2.tenses.used-to-states",
      "level": "B2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "used to for past states (I used to have long hair)",
      "es": "used to: estados del pasado que ya cambiaron",
      "example": {
        "en": "I used to have long hair.",
        "es": "Antes tenía el pelo largo."
      }
    },
    {
      "id": "b2.tenses.no-would-states",
      "level": "B2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "used to, not would, with states (not I would have a dog)",
      "es": "con estados (tener, ser, gustar) va used to, nunca would",
      "example": {
        "en": "When I was a child, I used to have a dog.",
        "es": "Cuando era niño, tenía un perro."
      }
    },
    {
      "id": "b2.tenses.didnt-use-to",
      "level": "B2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "didn't use to / Did you use to…? (use, not used)",
      "es": "no solía / ¿solías…? (use sin -d después de did)",
      "example": {
        "en": "I didn't use to like vegetables, but now I love them.",
        "es": "Antes no me gustaban las verduras, pero ahora me encantan."
      }
    },
    {
      "id": "b2.tenses.not-anymore",
      "level": "B2",
      "topics": ["tenses"],
      "kind": "phrase",
      "term": "not… anymore",
      "es": "ya no",
      "example": {
        "en": "I don't live there anymore.",
        "es": "Ya no vivo ahí."
      }
    },
    {
      "id": "b2.tenses.used-to-vs-be-used-to",
      "level": "B2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "used to do vs be used to doing",
      "es": "used to do: solía hacer · be used to doing: estar acostumbrado a hacer",
      "example": {
        "en": "I used to work at night, so I'm used to sleeping during the day.",
        "es": "Antes trabajaba de noche, así que estoy acostumbrado a dormir de día."
      }
    }
  ],
  "passages": [
    {
      "id": "b2.tenses.practice-past-habits-village",
      "level": "B2",
      "topics": ["tenses"],
      "title": "My grandmother's village",
      "text": "When my grandmother was young, life in her village was very different. There used to be only one phone, in the post office. In the evenings, families would sit outside and talk with their neighbors. My grandmother didn't use to go to school in winter, because the roads were too bad. She used to have a horse called Luna, and every morning she would ride it to the river to get water. The village doesn't look like that anymore: now there's a school, a paved road and good internet.",
      "source": { "kind": "original" }
    }
  ],
