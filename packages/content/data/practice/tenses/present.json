{
  "items": [
    {
      "id": "a2.tenses.present-simple-habits",
      "level": "A2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present simple for habits and facts (I work every day)",
      "es": "presente simple: hábitos, rutinas y cosas que siempre son ciertas",
      "example": {
        "en": "She works in a bank and takes the bus every day.",
        "es": "Trabaja en un banco y toma el autobús todos los días."
      }
    },
    {
      "id": "a2.tenses.present-continuous-now",
      "level": "A2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present continuous for now (I'm working)",
      "es": "presente continuo: lo que está pasando ahora",
      "example": {
        "en": "Be quiet! The baby is sleeping.",
        "es": "¡Silencio! El bebé está durmiendo."
      }
    },
    {
      "id": "a2.tenses.present-continuous-temporary",
      "level": "A2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "present continuous for temporary situations (I'm staying with a friend)",
      "es": "presente continuo: situaciones temporales",
      "example": {
        "en": "I'm staying with my cousin this month.",
        "es": "Me estoy quedando con mi primo este mes."
      }
    },
    {
      "id": "a2.tenses.at-the-moment",
      "level": "A2",
      "topics": ["tenses"],
      "kind": "phrase",
      "term": "at the moment",
      "es": "en este momento",
      "example": {
        "en": "Sorry, Mark is busy at the moment.",
        "es": "Perdón, Mark está ocupado en este momento."
      }
    },
    {
      "id": "a2.tenses.how-often",
      "level": "A2",
      "topics": ["tenses"],
      "kind": "phrase",
      "term": "How often…?",
      "es": "¿con qué frecuencia…?",
      "example": {
        "en": "How often do you go to the gym?",
        "es": "¿Con qué frecuencia vas al gimnasio?"
      }
    },
    {
      "id": "a2.tenses.do-does-questions",
      "level": "A2",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "do / does in present simple questions (Does she work?)",
      "es": "do / does para preguntar en presente simple",
      "example": {
        "en": "Does your sister live near here?",
        "es": "¿Tu hermana vive cerca de aquí?"
      }
    }
  ],
  "passages": [
    {
      "id": "a2.tenses.practice-present-lucia",
      "level": "A2",
      "topics": ["tenses"],
      "title": "A different month",
      "text": "Lucía is a nurse. She usually works at night and sleeps in the morning. But this month she is working during the day, because a coworker is on vacation. She doesn't like it very much: she gets up at six and she's always tired. Right now it's one o'clock, and she's having lunch with her friend Tom in the hospital cafeteria. Tom works in the same hospital. How often do they eat together? Only once or twice a month.",
      "source": { "kind": "original" }
    }
  ],
  "exercises": [
