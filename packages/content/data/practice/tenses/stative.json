{
  "items": [
    {
      "id": "b1.tenses.know-stative",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "know without -ing (I know, not I'm knowing)",
      "es": "know (saber, conocer) no va en forma continua",
      "example": {
        "en": "Do you know my brother?",
        "es": "¿Conoces a mi hermano?"
      }
    },
    {
      "id": "b1.tenses.want-need-stative",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "want / need without -ing (I want, not I'm wanting)",
      "es": "want (querer) y need (necesitar) no van en forma continua",
      "example": {
        "en": "Right now I want a big glass of water.",
        "es": "Ahora mismo quiero un vaso grande de agua."
      }
    },
    {
      "id": "b1.tenses.believe-understand",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "believe / understand without -ing (I understand)",
      "es": "believe (creer) y understand (entender): verbos mentales, sin -ing",
      "example": {
        "en": "Sorry, I don't understand what you mean.",
        "es": "Perdón, no entiendo lo que quieres decir."
      }
    },
    {
      "id": "b1.tenses.own-stative",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "own without -ing (He owns two restaurants)",
      "es": "own (ser dueño de, tener) no va en forma continua",
      "example": {
        "en": "My uncle owns two restaurants downtown.",
        "es": "Mi tío es dueño de dos restaurantes en el centro."
      }
    },
    {
      "id": "b1.tenses.think-have-two-meanings",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "think / have: state or action (I think so / I'm thinking about it)",
      "es": "think y have: sin -ing como estado (creer, tener), con -ing como acción (pensar, comer)",
      "example": {
        "en": "I'm having lunch with a client, but I think I can call you later.",
        "es": "Estoy almorzando con un cliente, pero creo que puedo llamarte más tarde."
      }
    },
    {
      "id": "b1.tenses.seem-stative",
      "level": "B1",
      "topics": ["tenses"],
      "kind": "grammar",
      "term": "seem without -ing (You seem tired)",
      "es": "seem (parecer) no va en forma continua",
      "example": {
        "en": "You seem worried. Is everything OK?",
        "es": "Pareces preocupado. ¿Está todo bien?"
      }
    }
  ],
  "passages": [
    {
      "id": "b1.tenses.practice-stative-leo",
      "level": "B1",
      "topics": ["tenses"],
      "title": "A message from college",
      "text": "Hi Mom, I'm writing from the library. I know you want me to call more often, and I understand why. The problem is that I don't have much free time this month. I'm thinking about getting a part-time job, but I'm not sure yet. My roommate seems nice. He owns a car, so he sometimes drives me to class. Oh, and I really need some new shoes. Can you send me a little money? Love, Leo",
      "source": { "kind": "original" }
    }
  ],
