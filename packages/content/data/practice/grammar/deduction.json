  "passages": [
    {
      "id": "b2.grammar.practice-deduction-cake",
      "level": "B2",
      "topics": ["grammar"],
      "title": "The missing cake",
      "text": "When Laura got home, the chocolate cake she had made for her party was gone. Only a few crumbs were left on the table. 'It can't have been my brother,' she thought. 'He's been at soccer practice all afternoon.' Her mom was at work too, so it couldn't have been her. Then Laura noticed small brown footprints on the kitchen floor. The dog was asleep under the table, and his nose was covered in chocolate. 'It must have been Max!' she said. 'He might have eaten the whole thing.'",
      "source": {
        "kind": "original"
      }
    }
  ],
