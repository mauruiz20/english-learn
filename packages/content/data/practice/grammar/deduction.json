{
  "items": [
    {
      "id": "b2.grammar.deduction-must-be",
      "level": "B2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "must be (I'm sure it is)",
      "es": "must be: debe de ser, seguro que es",
      "example": {
        "en": "You must be tired after such a long trip.",
        "es": "Debes de estar cansado después de un viaje tan largo."
      }
    },
    {
      "id": "b2.grammar.deduction-cant-be",
      "level": "B2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "can't be (I'm sure it isn't)",
      "es": "can't be: no puede ser, seguro que no es",
      "example": {
        "en": "That can't be Tom. He's in Japan.",
        "es": "Ese no puede ser Tom. Está en Japón."
      }
    },
    {
      "id": "b2.grammar.deduction-might-be",
      "level": "B2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "might / may / could be (maybe it is)",
      "es": "might, may o could be: puede que sea, quizás es",
      "example": {
        "en": "She might be at the gym.",
        "es": "Puede que esté en el gimnasio."
      }
    },
    {
      "id": "b2.grammar.deduction-must-have",
      "level": "B2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "must have done (I'm sure it happened)",
      "es": "must have + participio: debe de haber…, seguro que…",
      "example": {
        "en": "Someone must have taken my umbrella.",
        "es": "Alguien se debe de haber llevado mi paraguas."
      }
    },
    {
      "id": "b2.grammar.deduction-cant-have",
      "level": "B2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "can't have / couldn't have done (I'm sure it didn't happen)",
      "es": "can't have o couldn't have + participio: no puede haber…",
      "example": {
        "en": "He can't have seen us. It was too dark.",
        "es": "No puede habernos visto. Estaba demasiado oscuro."
      }
    },
    {
      "id": "b2.grammar.deduction-might-have",
      "level": "B2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "might have / may have done (maybe it happened)",
      "es": "might have o may have + participio: puede que haya…",
      "example": {
        "en": "I might have left my wallet at the restaurant.",
        "es": "Puede que haya dejado la billetera en el restaurante."
      }
    }
  ],
