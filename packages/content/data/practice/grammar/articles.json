{
  "items": [
    {
      "id": "a2.grammar.articles-a-an",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "a / an by sound (a car, an hour)",
      "es": "a / an: un, una (an antes de sonido vocálico)",
      "example": {
        "en": "I waited for an hour in a long line.",
        "es": "Esperé una hora en una fila larga."
      }
    },
    {
      "id": "a2.grammar.articles-jobs",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "a / an with jobs (She's a nurse.)",
      "es": "a / an con profesiones (en español no se usa)",
      "example": {
        "en": "My mom is an engineer.",
        "es": "Mi mamá es ingeniera."
      }
    },
    {
      "id": "a2.grammar.articles-the-specific",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "the for something specific or already mentioned",
      "es": "the: algo concreto o que ya se mencionó",
      "example": {
        "en": "I bought a shirt and a jacket. The jacket was cheap.",
        "es": "Compré una camisa y una chaqueta. La chaqueta fue barata."
      }
    },
    {
      "id": "a2.grammar.articles-zero-general",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "no article to talk in general (Dogs are…, Life is…)",
      "es": "sin artículo para hablar en general",
      "example": {
        "en": "Life is short, so enjoy it.",
        "es": "La vida es corta, así que disfrútala."
      }
    },
    {
      "id": "a2.grammar.articles-the-unique",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "the with unique things (the sun, the internet)",
      "es": "the con cosas únicas (el sol, internet)",
      "example": {
        "en": "The moon is beautiful tonight.",
        "es": "La luna está hermosa esta noche."
      }
    },
    {
      "id": "a2.grammar.articles-zero-places",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "no article with home, work, school and bed (go to work)",
      "es": "sin artículo: go home, at work, to school, in bed",
      "example": {
        "en": "He goes to bed at eleven.",
        "es": "Se acuesta a las once."
      }
    }
  ],
