{
  "items": [
    {
      "id": "a2.grammar.countable-uncountable-nouns",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "uncountable nouns (water, money, furniture)",
      "es": "sustantivos incontables: sin a / an y sin plural",
      "example": {
        "en": "We need some new furniture.",
        "es": "Necesitamos muebles nuevos."
      }
    },
    {
      "id": "a2.grammar.countable-a-few",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "a few + plural noun (a few friends)",
      "es": "a few: unos pocos, algunos (con plural)",
      "example": {
        "en": "I have a few friends in this city.",
        "es": "Tengo algunos amigos en esta ciudad."
      }
    },
    {
      "id": "a2.grammar.countable-a-little",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "a little + uncountable noun (a little sugar)",
      "es": "a little: un poco de (con incontables)",
      "example": {
        "en": "Can I have a little milk in my coffee?",
        "es": "¿Me puedes poner un poco de leche en el café?"
      }
    },
    {
      "id": "a2.grammar.countable-piece-of",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "phrase",
      "term": "a piece of advice",
      "es": "un consejo (advice no lleva a / an)",
      "example": {
        "en": "She gave me a good piece of advice.",
        "es": "Me dio un buen consejo."
      }
    },
    {
      "id": "a2.grammar.countable-no-plural",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "information, advice and news (no plural)",
      "es": "information, advice, news: siempre en singular",
      "example": {
        "en": "The news is good.",
        "es": "Las noticias son buenas."
      }
    },
    {
      "id": "a2.grammar.countable-not-much-many",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "not much / not many in negative sentences (not much time)",
      "es": "not much / not many: no mucho, no muchos",
      "example": {
        "en": "We don't have much time.",
        "es": "No tenemos mucho tiempo."
      }
    }
  ],
