  "passages": [
    {
      "id": "b1.grammar.practice-questions-quiz-night",
      "level": "B1",
      "topics": ["grammar"],
      "title": "Quiz night",
      "text": "Every Thursday, my friends and I go to quiz night at a bar near our office. The host asks twenty questions, and each team writes its answers on a piece of paper. Last week the questions were hard. 'What is the capital of Canada?' was easy, but 'How many bones are there in the human body?' wasn't. My friend Sam always says, 'We're going to win tonight, aren't we?' We never win, but we always have fun. At the end, the host asks, 'Who's coming back next week?' and everybody raises their hand.",
      "source": {
        "kind": "original"
      }
    }
  ],
