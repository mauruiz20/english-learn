{
  "items": [
    {
      "id": "b1.grammar.questions-word-order",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "question word order (Where do you live?)",
      "es": "orden de la pregunta: palabra interrogativa + auxiliar + sujeto + verbo",
      "example": {
        "en": "Where does your brother work?",
        "es": "¿Dónde trabaja tu hermano?"
      }
    },
    {
      "id": "b1.grammar.questions-subject",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "subject questions (Who called?)",
      "es": "preguntas de sujeto, sin do: ¿quién llamó?",
      "example": {
        "en": "Who called you this morning?",
        "es": "¿Quién te llamó esta mañana?"
      }
    },
    {
      "id": "b1.grammar.questions-preposition-end",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "questions ending in a preposition (Who are you talking to?)",
      "es": "preguntas con la preposición al final: ¿con quién hablas?",
      "example": {
        "en": "Who are you talking to?",
        "es": "¿Con quién estás hablando?"
      }
    },
    {
      "id": "b1.grammar.questions-indirect",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "indirect questions (Do you know where…?)",
      "es": "preguntas indirectas: ¿sabes dónde…? (sujeto antes del verbo)",
      "example": {
        "en": "Do you know where the station is?",
        "es": "¿Sabes dónde está la estación?"
      }
    },
    {
      "id": "b1.grammar.questions-tags",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "question tags (…, isn't it?)",
      "es": "question tags: ¿no?, ¿verdad? al final de la frase",
      "example": {
        "en": "It's a beautiful day, isn't it?",
        "es": "Es un día hermoso, ¿no?"
      }
    },
    {
      "id": "b1.grammar.questions-be-or-do",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "be or do in questions (Are you…? / Do you…?)",
      "es": "be o do en preguntas: ¿Are you…? o ¿Do you…?",
      "example": {
        "en": "Are you hungry? Do you want a sandwich?",
        "es": "¿Tienes hambre? ¿Quieres un sándwich?"
      }
    }
  ],
