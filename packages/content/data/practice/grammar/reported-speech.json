          "answerIndex": 1
        },
        {
          "prompt": "What did she ask the writer to send?",
          "options": ["A photo", "A list of hotels", "A copy of a diploma"],
          "answerIndex": 2
        },
        {
          "prompt": "What did the manager say this morning?",
          "options": [
