  "passages": [
    {
      "id": "b1.grammar.practice-reported-speech-interview",
      "level": "B1",
      "topics": ["grammar"],
      "title": "What the manager said",
      "text": "Yesterday I had a job interview at a hotel. The manager was very friendly. First, she asked me where I had worked before, and I told her about my summer job at a café. Then she asked me if I could work on weekends. I said that I could, but that I had classes on Monday mornings. At the end, she told me that they would call me the next day. She also asked me to send her a copy of my diploma. This morning she called and said I had the job!",
      "source": {
        "kind": "original"
      }
    }
  ],
