            "That she would call again",
            "That the job was gone"
          ],
          "answerIndex": 0
        }
      ]
    },
    {
      "id": "b1.grammar.practice-reported-speech-order-1",
      "itemIds": ["b1.grammar.reported-speech-wh-questions"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "word_order",
      "tokens": ["it", "me", "was.", "asked", "what", "She", "time"],
      "accepted": ["She asked me what time it was."],
      "es": "Me preguntó qué hora era."
    },
    {
      "id": "b1.grammar.practice-reported-speech-write-1",
      "itemIds": ["b1.grammar.reported-speech-told-me"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "translate_write",
      "es": "Me dijo que estaba cansado.",
      "accepted": ["{He|She} {told me|said|said to me} [that] he {was|is} tired."]
    },
    {
      "id": "b1.grammar.practice-reported-speech-choice-3",
      "itemIds": ["b1.grammar.reported-speech-requests"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "translation_choice",
      "sentence": "She asked us not to make any noise.",
      "options": [
        "Nos preguntó si hacíamos ruido.",
        "Nos pidió que no hiciéramos ruido.",
        "Nos dijo que no había ruido."
      ],
      "answerIndex": 1
    },
    {
      "id": "b1.grammar.practice-reported-speech-cloze-3",
      "itemIds": ["b1.grammar.reported-speech-will-would"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "cloze",
      "sentence": "Last week Tom said he ___ come to my party, but he never came.",
      "answers": ["would"],
      "distractors": ["will", "does"],
      "es": "La semana pasada Tom dijo que vendría a mi fiesta, pero nunca vino."
    },
    {
      "id": "b1.grammar.practice-reported-speech-order-2",
      "itemIds": ["b1.grammar.reported-speech-requests"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "word_order",
      "tokens": ["rest.", "me", "The", "to", "told", "doctor"],
      "accepted": ["The doctor told me to rest."],
      "es": "El médico me dijo que descansara."
    },
    {
      "id": "b1.grammar.practice-reported-speech-write-2",
      "itemIds": ["b1.grammar.reported-speech-wh-questions"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "translate_write",
      "es": "Me preguntó dónde trabajaba.",
      "accepted": ["{He|She} asked [me] where I {worked|was working|work}."]
    },
    {
      "id": "b1.grammar.practice-reported-speech-cloze-4",
      "itemIds": ["b1.grammar.reported-speech-backshift"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "cloze",
      "sentence": "Two years ago, Maria told me she ___ in Boston, but now she lives in Chicago.",
      "answers": ["lived"],
      "distractors": ["live", "living"],
      "es": "Hace dos años, María me dijo que vivía en Boston, pero ahora vive en Chicago."
    },
    {
