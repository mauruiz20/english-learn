{
  "items": [
    {
      "id": "b1.grammar.reported-speech-backshift",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "reported speech: one tense back (is → was)",
      "es": "estilo indirecto: el verbo retrocede un tiempo (is → was)",
      "example": {
        "en": "She said she was hungry.",
        "es": "Dijo que tenía hambre."
      }
    },
    {
      "id": "b1.grammar.reported-speech-told-me",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "told me / said to me (never said me)",
      "es": "told me o said to me: nunca said me",
      "example": {
        "en": "He told me he was busy.",
        "es": "Me dijo que estaba ocupado."
      }
    },
    {
      "id": "b1.grammar.reported-speech-will-would",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "reported speech: will → would",
      "es": "estilo indirecto: will pasa a would",
      "example": {
        "en": "They said they would help us.",
        "es": "Dijeron que nos ayudarían."
      }
    },
    {
      "id": "b1.grammar.reported-speech-wh-questions",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "reported questions with where / what (asked where I lived)",
      "es": "preguntas indirectas con wh-: me preguntó dónde vivía",
      "example": {
        "en": "She asked me where I worked.",
        "es": "Me preguntó dónde trabajaba."
      }
    },
    {
      "id": "b1.grammar.reported-speech-requests",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "reported requests (asked me to…)",
      "es": "peticiones en estilo indirecto: me pidió que…",
      "example": {
        "en": "My mom asked me to buy some bread.",
        "es": "Mi mamá me pidió que comprara pan."
      }
    },
    {
      "id": "b1.grammar.reported-speech-time-words",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "reported speech: time words (the next day)",
      "es": "estilo indirecto: palabras de tiempo (al día siguiente)",
      "example": {
        "en": "He said he would call the next day.",
        "es": "Dijo que llamaría al día siguiente."
      }
    }
  ],
  "exercises": [
    {
      "id": "b1.grammar.practice-reported-speech-vocab-1",
      "itemIds": ["b1.grammar.reported-speech-backshift"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "vocab",
      "prompt": "Ana said, 'I'm tired.' Which sentence reports it correctly?",
      "options": [
        "Ana said she tired.",
        "Ana said she was tired.",
        "Ana said me she was tired.",
        "Ana told that she was tired."
      ],
      "answerIndex": 1
    },
    {
      "id": "b1.grammar.practice-reported-speech-choice-1",
      "itemIds": ["b1.grammar.reported-speech-will-would"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "translation_choice",
      "sentence": "He said he would call me later.",
      "options": [
        "Dijo que me llamó más tarde.",
        "Me dijo que lo llamara más tarde.",
        "Dijo que me llamaría más tarde."
      ],
      "answerIndex": 2
    },
    {
      "id": "b1.grammar.practice-reported-speech-cloze-1",
      "itemIds": ["b1.grammar.reported-speech-told-me"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "cloze",
      "sentence": "She ___ me that the store was closed.",
      "answers": ["told"],
      "distractors": ["said", "asked"],
      "es": "Me dijo que la tienda estaba cerrada."
    },
    {
      "id": "b1.grammar.practice-reported-speech-choice-2",
      "itemIds": ["b1.grammar.reported-speech-wh-questions"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "translation_choice",
      "sentence": "The teacher asked me where I lived.",
      "options": [
        "La maestra me preguntó dónde vivía.",
        "La maestra me dijo dónde vivía.",
        "La maestra me preguntó si vivía cerca."
      ],
      "answerIndex": 0
    },
    {
      "id": "b1.grammar.practice-reported-speech-cloze-2",
      "itemIds": ["b1.grammar.reported-speech-requests"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "cloze",
      "sentence": "My boss asked me ___ send the report today.",
      "answers": ["to"],
      "distractors": ["that", "for"],
      "es": "Mi jefe me pidió que enviara el informe hoy."
    },
    {
      "id": "b1.grammar.practice-reported-speech-vocab-2",
      "itemIds": ["b1.grammar.reported-speech-time-words"],
      "level": "B1",
      "source": {
        "kind": "original"
      },
      "type": "vocab",
      "prompt": "What does 'the next day' mean in 'He said he would come back the next day.'?",
      "options": ["el día anterior", "al día siguiente", "hoy mismo", "la semana que viene"],
      "answerIndex": 1
    },
    {
      "id": "b1.grammar.practice-reported-speech-reading-1",
      "itemIds": [
