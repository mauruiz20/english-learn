  "passages": [
    {
      "id": "a2.grammar.practice-prepositions-saturday",
      "level": "A2",
      "topics": ["grammar"],
      "title": "A busy Saturday",
      "text": "On Saturday I got up at seven. In the morning I met my friend Sam at the bus stop, and we took the bus to the market. The market is in the old part of town. At noon we had lunch at a small café. In the afternoon I went home and read a book on the sofa. At night we went to a concert in the park. It was a long day, but it was fun!",
      "source": {
        "kind": "original"
      }
    }
  ],
