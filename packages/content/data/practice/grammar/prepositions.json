{
  "items": [
    {
      "id": "a2.grammar.prepositions-at-time",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "at + clock time and night (at six, at night)",
      "es": "at + hora (a las seis) y at night (de noche)",
      "example": {
        "en": "The movie starts at eight.",
        "es": "La película empieza a las ocho."
      }
    },
    {
      "id": "a2.grammar.prepositions-in-period",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "in + month, season or year (in July, in winter)",
      "es": "in + mes, estación o año",
      "example": {
        "en": "My birthday is in July.",
        "es": "Mi cumpleaños es en julio."
      }
    },
    {
      "id": "a2.grammar.prepositions-on-date",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "on + date or day part (on my birthday, on Friday night)",
      "es": "on + fecha o parte de un día concreto",
      "example": {
        "en": "We have a party on Friday night.",
        "es": "Tenemos una fiesta el viernes por la noche."
      }
    },
    {
      "id": "a2.grammar.prepositions-in-place",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "in + room, city or country (in the kitchen, in Mexico)",
      "es": "in + espacio cerrado, ciudad o país",
      "example": {
        "en": "The keys are in the kitchen.",
        "es": "Las llaves están en la cocina."
      }
    },
    {
      "id": "a2.grammar.prepositions-on-surface",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "on + surface or floor (on the table, on the third floor)",
      "es": "on + superficie o piso de un edificio",
      "example": {
        "en": "Your phone is on the table.",
        "es": "Tu teléfono está sobre la mesa."
      }
    },
    {
      "id": "a2.grammar.prepositions-at-point",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "at + point or event (at the bus stop, at a party)",
      "es": "at + punto concreto o evento",
      "example": {
        "en": "I'll wait for you at the bus stop.",
        "es": "Te espero en la parada del autobús."
      }
    }
  ],
