{
  "items": [
    {
      "id": "b1.grammar.gerund-infinitive-avoid-keep",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "avoid, keep, mind, enjoy + -ing (keep trying)",
      "es": "avoid / keep / mind / enjoy + verbo-ing",
      "example": {
        "en": "He kept asking me the same question.",
        "es": "Me seguía haciendo la misma pregunta."
      }
    },
    {
      "id": "b1.grammar.gerund-infinitive-plan-hope",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "plan, hope, promise + to + verb (promise to call)",
      "es": "plan / hope / promise + to + verbo",
      "example": {
        "en": "They promised to call me.",
        "es": "Prometieron llamarme."
      }
    },
    {
      "id": "b1.grammar.gerund-infinitive-after-preposition",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "preposition + -ing (good at cooking, without saying)",
      "es": "preposición + verbo-ing (nunca + infinitivo)",
      "example": {
        "en": "She left without saying goodbye.",
        "es": "Se fue sin despedirse."
      }
    },
    {
      "id": "b1.grammar.gerund-infinitive-subject",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "-ing as the subject (Walking is good for you.)",
      "es": "verbo-ing como sujeto (en español, el infinitivo)",
      "example": {
        "en": "Learning a language takes time.",
        "es": "Aprender un idioma lleva tiempo."
      }
    },
    {
      "id": "b1.grammar.gerund-infinitive-remember-forget",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "remember / forget + to (not forget to do something)",
      "es": "remember / forget + to: acordarse de / olvidarse de hacer algo",
      "example": {
        "en": "Please remember to turn off the lights.",
        "es": "Por favor, acuérdate de apagar las luces."
      }
    },
    {
      "id": "b1.grammar.gerund-infinitive-purpose",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "to + verb for purpose (I went out to buy milk.)",
      "es": "to + verbo: para (finalidad), nunca for to",
      "example": {
        "en": "I went to the store to buy some bread.",
        "es": "Fui a la tienda a comprar pan."
      }
    }
  ],
