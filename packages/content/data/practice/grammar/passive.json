{
  "items": [
    {
      "id": "b1.grammar.passive-is-made",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "present passive (it is made)",
      "es": "voz pasiva en presente: se hace, se fabrica",
      "example": {
        "en": "Most of these toys are made in China.",
        "es": "La mayoría de estos juguetes se fabrican en China."
      }
    },
    {
      "id": "b1.grammar.passive-was-built",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "past passive (it was built)",
      "es": "voz pasiva en pasado: se construyó, fue construido",
      "example": {
        "en": "The school was built in 1960.",
        "es": "La escuela se construyó en 1960."
      }
    },
    {
      "id": "b1.grammar.passive-has-been-done",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "present perfect passive (it has been sold)",
      "es": "voz pasiva en presente perfecto: se ha vendido, ha sido vendido",
      "example": {
        "en": "The house has been sold.",
        "es": "La casa ya se vendió."
      }
    },
    {
      "id": "b1.grammar.passive-modal",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "passive with modals (it can be done)",
      "es": "voz pasiva con modales: se puede hacer, debe hacerse",
      "example": {
        "en": "This problem can be fixed in a few minutes.",
        "es": "Este problema se puede arreglar en unos minutos."
      }
    },
    {
      "id": "b1.grammar.passive-by-agent",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "passive + by (written by…)",
      "es": "pasiva + by: quién hace la acción (escrito por…)",
      "example": {
        "en": "The letter was written by my grandmother.",
        "es": "La carta la escribió mi abuela."
      }
    },
    {
      "id": "b1.grammar.passive-question",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "passive questions (Where was it made?)",
      "es": "preguntas en voz pasiva: ¿dónde se hizo?",
      "example": {
        "en": "When was this photo taken?",
        "es": "¿Cuándo se tomó esta foto?"
      }
    }
  ],
