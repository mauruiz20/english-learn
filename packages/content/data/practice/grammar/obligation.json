{
  "items": [
    {
      "id": "b1.grammar.obligation-must-rules",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "must + base verb for rules (You must wear a helmet.)",
      "es": "must + verbo base (sin to): reglas y obligación fuerte",
      "example": {
        "en": "All passengers must wear a seat belt.",
        "es": "Todos los pasajeros deben usar el cinturón de seguridad."
      }
    },
    {
      "id": "b1.grammar.obligation-have-to-external",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "have to / has to for outside obligations (She has to start at six.)",
      "es": "have to / has to + verbo: tener que (obligación externa)",
      "example": {
        "en": "My sister has to wake up at five.",
        "es": "Mi hermana tiene que levantarse a las cinco."
      }
    },
    {
      "id": "b1.grammar.obligation-dont-have-to",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "don't have to = it isn't necessary (You don't have to pay.)",
      "es": "don't have to: no hace falta, no es necesario",
      "example": {
        "en": "You don't have to bring anything.",
        "es": "No hace falta que traigas nada."
      }
    },
    {
      "id": "b1.grammar.obligation-mustnt",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "mustn't = it isn't allowed (You mustn't park here.)",
      "es": "mustn't: está prohibido",
      "example": {
        "en": "You mustn't use your phone here.",
        "es": "Aquí no puedes usar el teléfono."
      }
    },
    {
      "id": "b1.grammar.obligation-had-to",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "had to (past obligation)",
      "es": "had to: tuve que, tuvo que",
      "example": {
        "en": "We had to wait two hours at the airport.",
        "es": "Tuvimos que esperar dos horas en el aeropuerto."
      }
    },
    {
      "id": "b1.grammar.obligation-ought-to",
      "level": "B1",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "ought to (advice)",
      "es": "ought to + verbo: deberías (consejo, como should)",
      "example": {
        "en": "You ought to rest more.",
        "es": "Deberías descansar más."
      }
    }
  ],
