    {
      "id": "b1.grammar.practice-obligation-pool-rules",
      "level": "B1",
      "topics": ["grammar"],
      "title": "Pool rules",
      "text": "Welcome to the city pool! Please read our rules. All swimmers must take a shower before they get in the water. You mustn't run near the pool, and you mustn't bring glass bottles. A child under ten has to swim with an adult. You don't have to bring a towel, because we have towels at the front desk. And you don't have to pay on Mondays: entry is free! Have fun and stay safe.",
      "source": {
        "kind": "original"
      }
    }
  ],
