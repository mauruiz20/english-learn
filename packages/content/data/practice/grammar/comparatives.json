  "passages": [
    {
      "id": "a2.grammar.practice-comparatives-two-cities",
      "level": "A2",
      "topics": ["grammar"],
      "title": "Two cities",
      "text": "Last year I lived in two cities, Monterrey and Toronto. Toronto is bigger than Monterrey, and it's much colder in winter. Monterrey is hotter and sunnier, and the food is cheaper. For me, the best thing about Toronto was the lake. The worst thing was the snow! People in Monterrey are as friendly as people in Toronto. Which city do I like more? That's a difficult question.",
      "source": {
        "kind": "original"
      }
    }
  ],
