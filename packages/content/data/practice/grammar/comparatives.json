{
  "items": [
    {
      "id": "a2.grammar.comparatives-short-er",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "cheaper than, bigger than (short adjectives)",
      "es": "adjetivo corto + -er + than: más… que",
      "example": {
        "en": "Today is colder than yesterday.",
        "es": "Hoy hace más frío que ayer."
      }
    },
    {
      "id": "a2.grammar.comparatives-more",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "more + long adjective + than (more expensive than)",
      "es": "more + adjetivo largo + than: más… que",
      "example": {
        "en": "This hotel is more expensive than the other one.",
        "es": "Este hotel es más caro que el otro."
      }
    },
    {
      "id": "a2.grammar.comparatives-superlative-est",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "the cheapest, the biggest (short adjectives)",
      "es": "the + adjetivo + -est: el más…",
      "example": {
        "en": "She's the youngest in her family.",
        "es": "Es la menor de su familia."
      }
    },
    {
      "id": "a2.grammar.comparatives-most",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "the most + long adjective (the most beautiful)",
      "es": "the most + adjetivo largo: el más…",
      "example": {
        "en": "This is the most important part.",
        "es": "Esta es la parte más importante."
      }
    },
    {
      "id": "a2.grammar.comparatives-irregular",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "better / the best, worse / the worst",
      "es": "comparativos irregulares: mejor, el mejor, peor, el peor",
      "example": {
        "en": "My English is better than last year.",
        "es": "Mi inglés está mejor que el año pasado."
      }
    },
    {
      "id": "a2.grammar.comparatives-as-as",
      "level": "A2",
      "topics": ["grammar"],
      "kind": "grammar",
      "term": "as + adjective + as (as tall as)",
      "es": "as… as: tan… como",
      "example": {
        "en": "My brother is as tall as my dad.",
        "es": "Mi hermano es tan alto como mi papá."
      }
    }
  ],
