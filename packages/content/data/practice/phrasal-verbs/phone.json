{
  "items": [
    {
      "id": "b1.phrasal-verbs.hang-up",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "hang up",
      "es": "colgar (el teléfono)",
      "example": {
        "en": "He got angry and hung up.",
        "es": "Se enojó y colgó."
      }
    },
    {
      "id": "b1.phrasal-verbs.call-back",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "call (someone) back",
      "es": "devolver la llamada, volver a llamar",
      "example": {
        "en": "I'm busy right now. Can I call you back later?",
        "es": "Ahora estoy ocupado. ¿Te puedo devolver la llamada más tarde?"
      }
    },
    {
      "id": "b1.phrasal-verbs.hold-on",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "hold on",
      "es": "esperar (un momento)",
      "example": {
        "en": "Hold on a minute, please. I'll check.",
        "es": "Espera un momento, por favor. Voy a revisar."
      }
    },
    {
      "id": "b1.phrasal-verbs.speak-up",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "speak up",
      "es": "hablar más fuerte",
      "example": {
        "en": "Could you speak up, please? I can't hear you.",
        "es": "¿Podrías hablar más fuerte, por favor? No te oigo."
      }
    },
    {
      "id": "b1.phrasal-verbs.get-through",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "get through",
      "es": "lograr comunicarse (por teléfono)",
      "example": {
        "en": "I called the bank, but I couldn't get through.",
        "es": "Llamé al banco, pero no pude comunicarme."
      }
    },
    {
      "id": "b1.phrasal-verbs.put-through",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "put (someone) through",
      "es": "comunicar, pasar la llamada (a alguien)",
      "example": {
        "en": "Can you put me through to the manager?",
        "es": "¿Me puedes comunicar con el gerente?"
      }
    }
  ],
