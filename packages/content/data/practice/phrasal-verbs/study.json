{
  "items": [
    {
      "id": "b1.phrasal-verbs.write-down",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "write (something) down",
      "es": "anotar, apuntar",
      "example": {
        "en": "Let me write down your phone number.",
        "es": "Déjame anotar tu número de teléfono."
      }
    },
    {
      "id": "b1.phrasal-verbs.go-over",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "go over (something)",
      "es": "repasar, revisar",
      "example": {
        "en": "Let's go over the answers together.",
        "es": "Repasemos las respuestas juntos."
      }
    },
    {
      "id": "b1.phrasal-verbs.read-up-on",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "read up on (something)",
      "es": "informarse (leyendo) sobre",
      "example": {
        "en": "Before the interview, she read up on the company.",
        "es": "Antes de la entrevista, se informó sobre la empresa."
      }
    },
    {
      "id": "b1.phrasal-verbs.fall-behind",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "fall behind",
      "es": "atrasarse, quedarse atrás",
      "example": {
        "en": "He was sick for two weeks and fell behind in math.",
        "es": "Estuvo enfermo dos semanas y se atrasó en matemáticas."
      }
    },
    {
      "id": "b1.phrasal-verbs.hand-out",
