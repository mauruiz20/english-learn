    {
      "id": "b2.phrasal-verbs.think-over",
      "level": "B2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "think (something) over",
      "es": "pensar bien, considerar (antes de decidir)",
      "example": {
        "en": "I need some time to think it over.",
        "es": "Necesito un poco de tiempo para pensarlo bien."
      }
    },
    {
      "id": "b2.phrasal-verbs.go-ahead-with",
      "level": "B2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "go ahead with (something)",
      "es": "seguir adelante con, llevar a cabo",
      "example": {
        "en": "We decided to go ahead with the trip despite the rain.",
        "es": "Decidimos seguir adelante con el viaje a pesar de la lluvia."
      }
    },
    {
      "id": "b2.phrasal-verbs.carry-on",
      "level": "B2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "carry on",
      "es": "continuar, seguir",
      "example": {
        "en": "Sorry to interrupt. Please carry on.",
        "es": "Perdón por interrumpir. Por favor, sigue."
      }
    },
    {
      "id": "b2.phrasal-verbs.back-out-of",
      "level": "B2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "back out of (something)",
      "es": "echarse para atrás, retirarse de (un plan o un acuerdo)",
      "example": {
        "en": "She backed out of the trip at the last minute.",
        "es": "Ella desistió del viaje a último momento."
      }
    },
    {
      "id": "b2.phrasal-verbs.settle-on",
      "level": "B2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "settle on (something)",
      "es": "decidirse por, elegir",
      "example": {
        "en": "After a long talk, we settled on a name for the baby.",
        "es": "Después de mucho hablar, nos decidimos por un nombre para el bebé."
      }
    },
    {
      "id": "b2.phrasal-verbs.go-through-with",
      "level": "B2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "go through with (something)",
      "es": "llevar a cabo (algo difícil o dudoso)",
      "example": {
        "en": "She was nervous, but she went through with it.",
        "es": "Estaba nerviosa, pero lo hizo de todos modos."
      }
    }
