{
  "items": [
    {
      "id": "a2.phrasal-verbs.get-in",
      "level": "A2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "get in (something)",
      "es": "subirse (a un auto o un taxi)",
      "example": {
        "en": "Get in the car. We're late!",
        "es": "Súbete al auto. ¡Vamos tarde!"
      }
    },
    {
      "id": "a2.phrasal-verbs.get-out-of",
      "level": "A2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "get out of (something)",
      "es": "bajarse (de un auto o un taxi), salir de",
      "example": {
        "en": "She got out of the taxi in front of the hotel.",
        "es": "Se bajó del taxi frente al hotel."
      }
    },
    {
      "id": "a2.phrasal-verbs.drop-off",
      "level": "A2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "drop (someone/something) off",
      "es": "dejar (a alguien o algo en un lugar)",
      "example": {
        "en": "Can you drop me off at the station?",
        "es": "¿Me puedes dejar en la estación?"
      }
    },
    {
      "id": "a2.phrasal-verbs.see-off",
      "level": "A2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "see (someone) off",
      "es": "despedir (a alguien que se va de viaje)",
      "example": {
        "en": "My parents came to the airport to see me off.",
        "es": "Mis papás vinieron al aeropuerto a despedirme."
      }
    },
    {
      "id": "a2.phrasal-verbs.go-away",
      "level": "A2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "go away",
      "es": "irse (de viaje); irse",
      "example": {
        "en": "We're going away for the weekend.",
        "es": "Nos vamos de viaje el fin de semana."
      }
    },
    {
      "id": "a2.phrasal-verbs.come-back",
      "level": "A2",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "come back",
      "es": "volver, regresar",
      "example": {
        "en": "When are you coming back from your vacation?",
        "es": "¿Cuándo vuelves de tus vacaciones?"
      }
    }
  ],
