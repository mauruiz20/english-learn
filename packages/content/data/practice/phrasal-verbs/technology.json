      "id": "b1.phrasal-verbs.shut-down",
      "level": "B1",
      "topics": ["phrasal-verbs"],
      "kind": "phrase",
      "term": "shut (something) down",
      "es": "apagar (una computadora o un sistema); cerrar (una empresa)",
