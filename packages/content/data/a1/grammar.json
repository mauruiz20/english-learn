      ]
    },
    {
      "id": "a1.grammar.a-an",
      "level": "A1",
      "topic": "grammar",
      "kind": "grammar",
      "title": "A o an",
      "summary": "A y an significan un o una. Se usa a antes de un sonido de consonante y an antes de un sonido de vocal.",
      "form": "a + sonido de consonante (a book, a car) · an + sonido de vocal (an apple, an egg)",
      "uses": [
        "Con una sola cosa o persona: a book, an apple.",
        "Para decir la profesión de alguien: She's a doctor. He's an artist.",
        "Cuenta el sonido, no la letra: an hour (la h no suena), a university (suena como «iu»)."
      ],
      "pitfalls": [
        {
          "wrong": "She is doctor.",
          "right": "She is a doctor.",
          "why": "Con una profesión en singular, el inglés usa a o an; el español no lleva artículo."
        },
        {
          "wrong": "I have a apple.",
          "right": "I have an apple.",
          "why": "Apple empieza con sonido de vocal, así que va an."
        },
        {
          "wrong": "I have a books.",
          "right": "I have books.",
          "why": "A y an son solo para una cosa; con un plural no se usan."
        }
      ],
      "examples": [
        {
          "en": "I have a dog.",
          "es": "Tengo un perro."
        },
        {
          "en": "She eats an apple every day.",
          "es": "Ella come una manzana todos los días."
        },
        {
          "en": "My mom is a teacher.",
          "es": "Mi mamá es maestra."
        },
        {
          "en": "He is an artist.",
          "es": "Él es artista."
        },
        {
          "en": "It's an old house.",
          "es": "Es una casa vieja."
        },
        {
          "en": "I need an umbrella.",
          "es": "Necesito un paraguas."
        }
      ],
      "itemIds": ["a1.grammar.a-an"],
      "exerciseIds": [
        "a1.grammar.a-an-cloze-1",
