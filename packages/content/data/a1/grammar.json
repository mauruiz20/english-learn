        "a1.grammar.a-an-choice-1",
        "a1.grammar.a-an-order-1",
        "a1.grammar.a-an-write-1"
      ]
    },
    {
      "id": "a1.grammar.plurals",
      "level": "A1",
      "topic": "grammar",
      "kind": "grammar",
      "title": "El plural",
      "summary": "Para hablar de más de una cosa, casi siempre se agrega -s. Algunas palabras agregan -es y otras cambian por completo.",
      "form": "book → books · box → boxes · baby → babies · child → children",
      "uses": [
        "La mayoría agrega -s: car → cars, sister → sisters.",
        "Después de s, x, ch o sh se agrega -es: bus → buses, box → boxes, watch → watches.",
        "Consonante + y cambia a -ies: baby → babies, city → cities.",
        "Irregulares frecuentes: man → men, woman → women, child → children, person → people."
      ],
      "pitfalls": [
        {
          "wrong": "I have two childs.",
          "right": "I have two children.",
          "why": "Child tiene un plural irregular: children."
        },
        {
          "wrong": "They are bigs houses.",
          "right": "They are big houses.",
          "why": "Los adjetivos en inglés no tienen plural: big houses."
        },
        {
          "wrong": "The people is nice.",
          "right": "The people are nice.",
          "why": "People ya es plural, así que va con are."
        }
      ],
      "examples": [
        {
          "en": "I have two brothers.",
          "es": "Tengo dos hermanos."
        },
        {
          "en": "There are three boxes on the table.",
          "es": "Hay tres cajas sobre la mesa."
        },
        {
          "en": "My sister has two babies.",
          "es": "Mi hermana tiene dos bebés."
        },
        {
          "en": "The children are at school.",
          "es": "Los niños están en la escuela."
        },
        {
          "en": "Those women are teachers.",
          "es": "Esas mujeres son maestras."
        },
        {
          "en": "These people are my friends.",
          "es": "Estas personas son mis amigos."
        }
      ],
      "itemIds": ["a1.grammar.plurals"],
      "exerciseIds": [
        "a1.grammar.plurals-cloze-1",
