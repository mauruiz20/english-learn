  "cards": [
    {
      "id": "a1.grammar.to-be",
      "level": "A1",
      "topic": "grammar",
      "kind": "grammar",
      "title": "El verbo to be",
      "summary": "To be significa ser y estar. En presente tiene tres formas: am, is y are.",
      "form": "I am · he / she / it is · you / we / they are (negativo: is not / isn't; pregunta: Are you...?)",
      "uses": [
        "Para decir quién eres, de dónde eres o a qué te dedicas: I'm Ana. I'm from Peru. I'm a student.",
        "Para decir cómo estás o dónde estás: I'm tired. She's at home.",
        "Para la edad: I'm ten years old (no I have ten years).",
        "Contracciones frecuentes: I'm, you're, he's, she's, it's, we're, they're; isn't, aren't."
      ],
      "pitfalls": [
        {
          "wrong": "Is very cold.",
          "right": "It is very cold.",
          "why": "En inglés el sujeto es obligatorio; si no hay otro, se usa it."
        },
        {
          "wrong": "I have twenty years.",
          "right": "I am twenty years old.",
          "why": "La edad se dice con to be, no con have."
        },
        {
          "wrong": "She no is my sister.",
          "right": "She isn't my sister.",
          "why": "La negación va después de to be: is not o isn't."
        },
        {
          "wrong": "You are a student?",
          "right": "Are you a student?",
          "why": "En las preguntas, am, is o are van antes del sujeto."
        }
      ],
      "examples": [
        {
          "en": "I am a student.",
          "es": "Soy estudiante."
        },
        {
          "en": "She is my teacher.",
          "es": "Ella es mi maestra."
        },
        {
          "en": "We are from Mexico.",
          "es": "Somos de México."
        },
        {
          "en": "It is cold today.",
          "es": "Hoy hace frío."
        },
        {
          "en": "He isn't at home.",
          "es": "Él no está en casa."
        },
        {
          "en": "Are you happy?",
          "es": "¿Estás contento?"
        }
      ],
      "itemIds": ["a1.grammar.to-be"],
      "exerciseIds": [
        "a1.grammar.to-be-cloze-1",
