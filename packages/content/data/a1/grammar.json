        "a1.grammar.plurals-choice-1",
        "a1.grammar.plurals-order-1",
        "a1.grammar.plurals-write-1"
      ]
    },
    {
      "id": "a1.grammar.this-that",
      "level": "A1",
      "topic": "grammar",
      "kind": "grammar",
      "title": "This, that, these, those",
      "summary": "Sirven para señalar cosas y personas. This y these son para lo que está cerca; that y those, para lo que está lejos.",
      "form": "cerca: this (singular) · these (plural) — lejos: that (singular) · those (plural)",
      "uses": [
        "This o that + singular: this shirt, that car.",
        "These o those + plural: these shoes, those books.",
        "Para presentar a alguien: This is my sister, Ana.",
        "Solos, sin sustantivo: What's that? Is this your bag?"
      ],
      "pitfalls": [
        {
          "wrong": "This shoes are new.",
          "right": "These shoes are new.",
          "why": "Con un plural se usa these (cerca) o those (lejos), no this."
        },
        {
          "wrong": "Those is my car.",
          "right": "That is my car.",
          "why": "That es para una sola cosa; those es para varias."
        },
        {
          "wrong": "This are my friends.",
          "right": "These are my friends.",
          "why": "Con are y un plural, se usa these."
        }
      ],
      "examples": [
        {
          "en": "This is my brother, Tom.",
          "es": "Este es mi hermano, Tom."
        },
        {
          "en": "That house is very big.",
          "es": "Esa casa es muy grande."
        },
        {
          "en": "These apples are green.",
          "es": "Estas manzanas son verdes."
        },
        {
          "en": "Those children are my cousins.",
          "es": "Esos niños son mis primos."
        },
        {
          "en": "Is this your phone?",
          "es": "¿Este es tu teléfono?"
        },
        {
          "en": "What's that?",
          "es": "¿Qué es eso?"
        }
      ],
      "itemIds": ["a1.grammar.this-that"],
