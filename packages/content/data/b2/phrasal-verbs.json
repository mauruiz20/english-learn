  "cards": [
    {
      "id": "b2.phrasal-verbs.ideas-and-results",
      "level": "B2",
      "topic": "phrasal-verbs",
      "kind": "phrasal_verbs",
      "title": "Phrasal verbs: ideas, planes y resultados",
      "summary": "Cinco phrasal verbs frecuentes en el trabajo y en las noticias para realizar, señalar, descartar y comentar ideas, y para contar cómo resultó algo.",
      "form": "verbo + partícula; en los separables, un pronombre va en el medio: point it out, rule it out",
      "uses": [
        "Proyectos: carry out a study, a survey or a plan (llevar a cabo).",
        "En reuniones: point out a problem (señalar), bring up a subject (sacar un tema).",
        "Descartar opciones: rule out a possibility.",
        "Contar un resultado inesperado: It turned out that… / turn out to be…"
      ],
      "pitfalls": [
        {
          "wrong": "We realized a survey.",
          "right": "We carried out a survey.",
          "why": "Realizar (llevar a cabo) es carry out; realize significa darse cuenta."
        },
        {
          "wrong": "She pointed out it.",
          "right": "She pointed it out.",
          "why": "Con un pronombre, este va entre point y out."
        },
        {
          "wrong": "The movie resulted boring.",
          "right": "The movie turned out to be boring.",
          "why": "Resultar (ser) se dice turn out to be; result in significa causar."
        },
        {
          "wrong": "He touched the subject of money.",
          "right": "He brought up the subject of money.",
          "why": "Tocar un tema o sacarlo en una conversación es bring up."
        }
      ],
      "examples": [
        {
          "en": "The company carried out a study on remote work.",
          "es": "La empresa realizó un estudio sobre el trabajo remoto."
        },
        {
          "en": "My boss pointed out that we were over budget.",
          "es": "Mi jefe señaló que nos habíamos pasado del presupuesto."
        },
        {
          "en": "The police have ruled out an accident.",
          "es": "La policía descartó que fuera un accidente."
        },
        {
          "en": "It turned out that she was right.",
          "es": "Resultó que ella tenía razón."
        },
        {
          "en": "I didn't want to bring up the subject at dinner.",
          "es": "No quería sacar el tema durante la cena."
        }
      ],
      "entries": [
        {
          "verb": "carry out",
          "es": "llevar a cabo, realizar",
          "separable": true,
          "example": {
            "en": "The team carried out a survey.",
            "es": "El equipo realizó una encuesta."
          }
        },
        {
          "verb": "point out",
          "es": "señalar, hacer notar",
          "separable": true,
          "example": {
            "en": "She pointed out a mistake in the report.",
            "es": "Señaló un error en el informe."
          }
        },
        {
          "verb": "rule out",
          "es": "descartar",
          "separable": true,
          "example": {
            "en": "We can't rule out that possibility.",
            "es": "No podemos descartar esa posibilidad."
          }
        },
        {
          "verb": "turn out",
          "es": "resultar",
          "separable": false,
          "example": {
            "en": "The test turned out to be easier than we expected.",
            "es": "El examen resultó ser más fácil de lo que esperábamos."
          }
        },
        {
          "verb": "bring up",
          "es": "sacar (un tema), mencionar",
          "separable": true,
          "example": {
            "en": "Don't bring up politics at dinner.",
            "es": "No saques el tema de la política en la cena."
          }
        }
      ],
      "itemIds": [
