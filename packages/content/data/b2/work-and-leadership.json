  "passages": [
    {
      "id": "b2.work-and-leadership.new-manager",
      "level": "B2",
      "topics": ["work-and-leadership"],
      "title": "Learning to lead",
      "text": "When Laura was asked to manage a team of eight designers, she was nervous: she had never been anyone's boss before. In her first month, she tried to do everything herself, and her workload soon became impossible. An older colleague pointed out that a good leader does not do all the work; she makes sure the work gets done. So Laura learned to delegate. She gave each person a clear task and trusted them to carry it out in their own way. She also changed the weekly meeting. Instead of talking for an hour herself, she asked everyone to bring up one problem and one idea. At first the staff were quiet, but soon the meeting became the most useful hour of the week. Laura also learned to give feedback in private and to thank people in public. Six months later, the team was meeting every deadline, and two designers who had planned to leave decided to stay. \"I'm not the smartest person in the room,\" Laura says. \"My job is to help the smartest people do their best work.\"",
      "source": {
        "kind": "original"
      }
    }
  ],
