  "passages": [
    {
      "id": "b1.culture-and-entertainment.night-at-theater",
      "level": "B1",
      "topics": ["culture-and-entertainment"],
      "title": "A night at the theater",
      "text": "Last Saturday I went to see a play at the old theater downtown. My friend Pablo, who is studying drama, had recommended it for weeks. The tickets were almost sold out, but we found two seats in the last row. The play is about a woman who goes back to the village where she grew up after thirty years away. At first I thought it might be boring, because the first scene was very slow. However, the main actress was amazing, and the audience was completely silent during her final speech. When the lights came on, some people were crying. \"She must be the best actress in the city,\" Pablo said. A review in the newspaper had said that the play was too long and too sad, but I think the writer was wrong. The director came on stage at the end and thanked everyone for coming. I'm already looking forward to seeing his next production. If you get the chance, it's definitely worth seeing.",
      "source": { "kind": "original" }
    }
  ],
