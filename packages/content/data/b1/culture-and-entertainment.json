        "b1.culture-and-entertainment.write-003"
      ],
      "newItemIds": [
        "b1.culture-and-entertainment.sold-out",
        "b1.culture-and-entertainment.director",
        "b1.culture-and-entertainment.worth"
      ],
      "intro": {
        "points": [
          "«sold out» significa agotado: ya no quedan entradas.",
          "«be worth» + -ing es valer la pena: «That movie is worth seeing».",
          "Repasa la deducción: «Everyone is laughing. The movie must be funny»."
        ],
        "examples": [
          { "en": "That movie is worth seeing.", "es": "Vale la pena ver esa película." },
          {
            "en": "The concert was sold out, so we stayed home.",
            "es": "Las entradas del concierto estaban agotadas, así que nos quedamos en casa."
          }
        ],
        "mistake": {
          "wrong": "That movie is worth to see.",
          "right": "That movie is worth seeing.",
          "note": "Después de «worth» va el verbo con -ing, nunca «to» + verbo."
        }
      }
    }
  ]
