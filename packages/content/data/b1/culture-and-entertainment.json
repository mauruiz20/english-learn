  "lessons": [
    {
      "id": "b1.culture-and-entertainment.lesson-001",
      "level": "B1",
      "topic": "culture-and-entertainment",
      "title": "Una noche de cultura",
      "exerciseIds": [
        "b1.culture-and-entertainment.vocab-001",
        "b1.culture-and-entertainment.cloze-001",
        "b1.culture-and-entertainment.order-001",
        "b1.culture-and-entertainment.choice-001",
        "b1.culture-and-entertainment.reading-001",
        "b1.culture-and-entertainment.write-001",
        "b1.culture-and-entertainment.vocab-002"
      ],
      "newItemIds": [
        "b1.culture-and-entertainment.audience",
        "b1.culture-and-entertainment.relative-who-where",
        "b1.culture-and-entertainment.exhibition",
        "b1.culture-and-entertainment.must-cant-might",
        "b1.culture-and-entertainment.look-forward"
      ],
      "deepenCardIds": [
        "b1.grammar.look-forward-to",
        "b1.grammar.relative-clauses",
        "b1.grammar.deduction"
      ],
      "intro": {
        "points": [
          "«who» se refiere a personas y «where» a lugares: «the place where my father was born».",
          "Para deducir: «must» (seguro que sí), «can't» (seguro que no) y «might» (puede que).",
          "«look forward to» va con un sustantivo o con un verbo en -ing: «I look forward to seeing you»."
        ],
        "examples": [
          {
            "en": "We went to an exhibition of modern art.",
            "es": "Fuimos a una exposición de arte moderno."
          },
          {
            "en": "She must be tired after a long walk.",
            "es": "Debe de estar cansada después de una larga caminata."
          }
        ],
        "mistake": {
          "wrong": "I look forward to see you.",
          "right": "I look forward to seeing you.",
          "note": "Aquí «to» es una preposición, no parte del infinitivo: después va el verbo con -ing."
        }
      }
    },
    {
