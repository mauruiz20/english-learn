  "passages": [
    {
      "id": "b1.technology.lost-project",
      "level": "B1",
      "topics": ["technology"],
      "title": "The project I almost lost",
      "text": "Last week my laptop stopped working the night before an important school project was due. I had written most of it on the laptop, and I hadn't backed up my files. I was really worried. My older brother, who works in IT, told me not to panic. He explained that many apps that we use every day save our work automatically online. I logged in to my account on his computer, and there it was: a copy of the document had been saved two days earlier. I lost only one page. The next day my laptop was taken to a repair shop. The technician said the problem was caused by an update that never finished installing. Now I update my devices every week, I use a strong password, and I back up my files every Friday. I also keep a charger in my bag, because a phone with no battery is not very useful in an emergency.",
      "source": {
        "kind": "original"
      }
    }
  ],
