  "lessons": [
    {
      "id": "b1.travel.lesson-001",
      "level": "B1",
      "topic": "travel",
      "title": "De viaje",
      "exerciseIds": [
        "b1.travel.vocab-001",
        "b1.travel.cloze-001",
        "b1.travel.order-001",
        "b1.travel.choice-001",
        "b1.travel.reading-001",
        "b1.travel.write-001"
      ],
      "newItemIds": [
        "b1.travel.delayed",
        "b1.travel.although",
        "b1.travel.book",
        "b1.travel.get-lost"
      ],
      "deepenCardIds": ["b1.grammar.although", "b1.vocabulary.get-adjective"],
      "intro": {
        "points": [
          "«although» significa aunque: une dos ideas que contrastan.",
          "«but» va en medio de la oración; «However,» empieza una oración nueva.",
          "«book» también es verbo, reservar: «We booked a room online».",
          "«get lost» es perderse: «We got lost in the old town»."
        ],
        "examples": [
          {
            "en": "Although the flight was delayed, we arrived on time.",
            "es": "Aunque el vuelo se retrasó, llegamos a tiempo."
          },
          { "en": "We booked a room online.", "es": "Reservamos una habitación por internet." }
        ],
        "mistake": {
          "wrong": "Although it was expensive, but we stayed.",
          "right": "Although it was expensive, we stayed.",
          "note": "Con «although» no hace falta «but»: usa solo uno de los dos."
        }
      }
    },
    {
      "id": "b1.travel.lesson-002",
      "level": "B1",
      "topic": "travel",
      "title": "Experiencias de viaje",
      "exerciseIds": [
