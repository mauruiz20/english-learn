      "newItemIds": [
        "b1.travel.luggage",
        "b1.travel.have-ever-been",
        "b1.travel.present-perfect-past-simple",
        "b1.travel.set-off",
        "b1.travel.check-in"
      ],
      "deepenCardIds": ["b1.grammar.present-perfect-past-simple", "b1.phrasal-verbs.travel"],
      "intro": {
        "points": [
          "Presente perfecto para experiencias sin fecha: «Have you ever been to Mexico?».",
          "Pasado simple cuando dices cuándo: «We went to Rome last summer».",
          "«been to» es haber ido y volver; «gone to», haberse ido y seguir allá.",
          "«luggage» es incontable: «a lot of luggage», nunca con -s."
        ],
        "examples": [
          { "en": "Have you ever been to Mexico?", "es": "¿Alguna vez has estado en México?" },
          { "en": "We went to Rome last summer.", "es": "Fuimos a Roma el verano pasado." }
        ],
        "mistake": {
          "wrong": "I have been to Rome last year.",
          "right": "I went to Rome last year.",
          "note": "Con un momento concreto del pasado («last year», «in 2019») usa el pasado simple."
        }
      }
    }
