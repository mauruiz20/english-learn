  "passages": [
    {
      "id": "b1.education.difficult-semester",
      "level": "B1",
      "topics": ["education"],
      "title": "A difficult semester",
      "text": "Last semester was hard for Sofía. She was studying engineering at a public university, and she was also working at a café three evenings a week. One night in November, while she was taking notes in the library, her phone rang. It was her manager. He said that he needed her at work immediately. Sofía told him that she had an important exam the next day, and he finally agreed to let her stay. Unfortunately, she failed that exam anyway, because she was too tired to concentrate. A few days later, her math teacher asked her if everything was OK. Sofía explained her situation, and the teacher told her about a scholarship for students who work. She applied, and two months later she got it. Now she doesn't have to work in the evenings. She hands in her homework on time, and she passed all her subjects in the spring. \"I was trying to do everything alone,\" she says. \"Asking for help was the best decision I made.\"",
      "source": { "kind": "original" }
    }
  ],
