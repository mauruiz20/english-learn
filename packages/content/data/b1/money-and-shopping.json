        "b1.money-and-shopping.reading-001",
        "b1.money-and-shopping.write-001",
        "b1.money-and-shopping.vocab-002"
      ],
      "newItemIds": [
        "b1.money-and-shopping.pay-back",
        "b1.money-and-shopping.second-conditional",
        "b1.money-and-shopping.save-up",
        "b1.money-and-shopping.lend",
        "b1.money-and-shopping.borrow"
      ],
      "deepenCardIds": ["b1.grammar.second-conditional", "b1.vocabulary.borrow-lend"],
      "intro": {
        "points": [
          "Segundo condicional, para lo hipotético: «if» + pasado, «would» + verbo.",
          "«lend» es prestar (das tú); «borrow» es pedir prestado (recibes tú).",
          "«pay back» es devolver dinero: «I'll pay you back»; «save up for» es ahorrar para algo."
        ],
        "examples": [
          {
            "en": "If I won the lottery, I'd buy a new car.",
            "es": "Si ganara la lotería, me compraría un auto nuevo."
          },
          {
            "en": "Can I borrow your bike? I'll give it back tomorrow.",
            "es": "¿Me prestas tu bicicleta? Te la devuelvo mañana."
          }
        ],
        "mistake": {
          "wrong": "Can you borrow me ten dollars?",
          "right": "Can you lend me ten dollars?",
          "note": "Pide con «Can you lend me…?» o con «Can I borrow…?»; «borrow me» no existe."
        }
      }
    },
    {
      "id": "b1.money-and-shopping.lesson-002",
      "level": "B1",
      "topic": "money-and-shopping",
      "title": "De compras",
      "exerciseIds": [
