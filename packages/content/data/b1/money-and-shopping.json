        "b1.money-and-shopping.cloze-003",
        "b1.money-and-shopping.order-002",
        "b1.money-and-shopping.choice-002",
        "b1.money-and-shopping.write-002",
        "b1.money-and-shopping.write-003"
      ],
      "newItemIds": [
        "b1.money-and-shopping.bargain",
        "b1.money-and-shopping.credit-card",
        "b1.money-and-shopping.refund"
      ],
      "intro": {
        "points": [
          "«bargain» es una ganga, algo bueno y barato: «It was a real bargain».",
          "Se paga «by credit card» o «in cash»: «Can I pay by credit card?».",
          "«refund» es la devolución del dinero: «I'd like a refund, please».",
          "Repasa: «If I had more money, I would travel»: después de «if», pasado."
        ],
        "examples": [
          { "en": "Can I pay by credit card?", "es": "¿Puedo pagar con tarjeta de crédito?" },
          {
            "en": "These shoes don't fit. I'd like a refund, please.",
            "es": "Estos zapatos no me quedan. Quisiera un reembolso, por favor."
          }
        ],
        "mistake": {
          "wrong": "If I would have more money, I would travel.",
          "right": "If I had more money, I would travel.",
          "note": "Después de «if» va el pasado simple, no «would»."
        }
      }
    }
  ]
