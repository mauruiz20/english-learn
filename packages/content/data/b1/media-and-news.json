  "lessons": [
    {
      "id": "b1.media-and-news.lesson-001",
      "level": "B1",
      "topic": "media-and-news",
      "title": "Leer las noticias",
      "exerciseIds": [
        "b1.media-and-news.vocab-001",
        "b1.media-and-news.cloze-001",
        "b1.media-and-news.order-001",
        "b1.media-and-news.choice-001",
        "b1.media-and-news.reading-001",
        "b1.media-and-news.write-001",
        "b1.media-and-news.vocab-002"
      ],
      "newItemIds": [
        "b1.media-and-news.headline",
        "b1.media-and-news.say-tell",
        "b1.media-and-news.news",
        "b1.media-and-news.according-to",
        "b1.media-and-news.fake-news"
      ],
      "deepenCardIds": ["a2.grammar.say-tell"],
      "intro": {
        "points": [
          "«say» va con lo que se dice; «tell», con a quién: «She told me that…», «She said that…».",
          "«news» es incontable y va en singular: «The news is good», nunca «a news».",
          "«according to» significa según: «According to the news, …»."
        ],
        "examples": [
          {
            "en": "She told me that the story wasn't true.",
            "es": "Me dijo que la historia no era cierta."
          },
          {
            "en": "According to the headline, prices will go up.",
            "es": "Según el titular, los precios van a subir."
          }
        ],
        "mistake": {
          "wrong": "He said me the news.",
          "right": "He told me the news.",
          "note": "Si dices a quién, usa «tell»: «told me». «said» va sin persona o con «to»: «said to me»."
        }
      }
    },
    {
      "id": "b1.media-and-news.lesson-002",
      "level": "B1",
      "topic": "media-and-news",
      "title": "Quién dijo qué",
      "exerciseIds": [
        "b1.media-and-news.vocab-003",
        "b1.media-and-news.cloze-002",
        "b1.media-and-news.cloze-003",
        "b1.media-and-news.order-002",
        "b1.media-and-news.choice-002",
        "b1.media-and-news.write-002",
        "b1.media-and-news.write-003"
      ],
      "newItemIds": [
        "b1.media-and-news.announce",
        "b1.media-and-news.passive-past",
        "b1.media-and-news.find-out"
      ],
      "deepenCardIds": ["b1.grammar.passive"],
      "intro": {
        "points": [
          "Pasiva en pasado: «was / were» + participio: «The winner was announced».",
          "Úsala cuando importa la acción y no quién la hace; para nombrarlo, agrega «by».",
          "«find out» es averiguar o enterarse: «I need to find out what went wrong»."
        ],
        "examples": [
          {
            "en": "The winner was announced on the evening news.",
            "es": "El ganador se anunció en el noticiero de la noche."
          },
          {
            "en": "The story was published by a young journalist.",
            "es": "La noticia fue publicada por un periodista joven."
          }
        ],
        "mistake": {
          "wrong": "The winner announced yesterday.",
          "right": "The winner was announced yesterday.",
          "note": "“Se anunció” es pasiva: no olvides «was» o «were» + participio."
        }
      }
    }
  ]
