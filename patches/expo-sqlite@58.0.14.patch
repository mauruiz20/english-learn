+// [english-learn patch] See the `releaseAccessHandles` message above.
+async function releaseAccessHandles(): Promise<void> {
+  _released = true;
+  let firstError: unknown = null;
+  if (_sqlite3 != null) {
+    for (const [nativeSessionId, session] of sessionIdMap) {
+      sessionIdMap.delete(nativeSessionId);
+      try {
+        _sqlite3.session_delete(session.pointer);
+      } catch (e) {
+        firstError ??= e;
+      }
+    }
+    for (const [nativeStatementId, statement] of statementIdMap) {
+      statementIdMap.delete(nativeStatementId);
+      try {
+        await _sqlite3.finalize(statement.pointer);
+      } catch (e) {
+        firstError ??= e;
+      }
+    }
+    const pointers = new Set([...databaseIdMap.values()].map((entity) => entity.pointer));
+    databaseIdMap.clear();
+    for (const pointer of pointers) {
+      try {
+        await _sqlite3.close(pointer);
+      } catch (e) {
+        firstError ??= e;
+      }
+    }
+  }
+  // Closes every sync access handle of the pool, whatever happened above.
+  await _vfs?.close();
+  if (firstError != null) throw firstError;
+}
