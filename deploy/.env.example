# Copy to deploy/.env (git-ignored) and adjust. No secrets here: they live in
# deploy/secrets/ (see secrets/README.md).

# GHCR namespace of the images, lowercase (the GitHub user or org).
GHCR_OWNER=mauruiz20

# Image tag to run. Pin a commit tag (sha-<7 chars>) or a release (1.2.3) in
# production; "latest" follows main.
IMAGE_TAG=latest

# Host directory for persistent data (postgres/, backups/), on the NVMe.
DATA_DIR=/mnt/nvme/english-learn

POSTGRES_USER=english_learn
POSTGRES_DB=english_learn

# Public hostname of the api: the Cloudflare Tunnel route (docs/deploy.md §4).
# Not read by the containers; the docs' checks use it. One level below the
# zone apex only: Universal SSL does not cover api.english.maumar.com.ar.
# Pending owner confirmation.
PUBLIC_API_HOSTNAME=english-api.maumar.com.ar

# Browser origins allowed to call the api (comma-separated, https only in
# production): the web app.
CORS_ORIGINS=https://english.maumar.com.ar

# Google OAuth client ids accepted as the ID token audience (comma-separated).
# Public values: the web client.
GOOGLE_CLIENT_IDS=78200832989-odkefhj0s4vla7h5p83gevs2440mctev.apps.googleusercontent.com

# Subnet of the internal backend network. The api trusts X-Forwarded-For only
# from it (cloudflared). Must not overlap another Docker network on the Pi or
# the LAN: check with `docker network inspect $(docker network ls -q)
# --format '{{.Name}} {{range .IPAM.Config}}{{.Subnet}}{{end}}'`.
BACKEND_SUBNET=10.217.0.0/24

# Backups (docs/deploy.md#backups): how many nightly dumps to keep, and the RAM
# for the restore drill's throwaway Postgres (tmpfs; keep it above the size of
# the restored database).
BACKUP_KEEP=14
BACKUP_SCRATCH_SIZE=256m
